<div class="create-journal-page">
  <!-- Header dengan Back Button -->
  <div class="wizard-header">
    <a href="/admin/contexts" class="back-button">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </a>
    
    <h1 class="wizard-title">Create Journal</h1>
  </div>
  <!-- Language Switcher -->
  <div class="language-switcher">
    <a href="#" class="lang-link active">Indonesian</a> <a href="#" class="lang-link">English</a>
  </div>
  <!-- Form Card -->
  <div class="wizard-form-card">
    <form method="POST" action="/admin/createJournal">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <!-- Journal Title -->
      <div class="form-field">
        <label class="field-label">
          Journal title <span class="required">*</span>
        </label>
        
        <div class="input-with-icon">
          <span class="input-icon">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              
              <path d="M2 12h20"></path>
              
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
              </path>
            </svg>
          </span>
           <input type="text" name="journal_title" required class="form-control" />
        </div>
        
        <p class="field-description">This is the official title of the journal.</p>
      </div>
      <!-- Journal Initials -->
      <div class="form-field">
        <label class="field-label">
          Journal initials <span class="required">*</span>
        </label>
        
        <div class="input-with-icon">
          <span class="input-icon">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              
              <path d="M2 12h20"></path>
              
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
              </path>
            </svg>
          </span>
           <input type="text" name="journal_initials" required class="form-control" />
        </div>
      </div>
      <!-- Journal Abbreviation -->
      <div class="form-field">
        <label class="field-label">
          Journal Abbreviation
        </label>
        
        <div class="input-with-icon">
          <span class="input-icon">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              
              <path d="M2 12h20"></path>
              
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
              </path>
            </svg>
          </span>
           <input type="text" name="journal_abbreviation" class="form-control" />
        </div>
      </div>
      <!-- Principal Contact Name -->
      <div class="form-field">
        <label class="field-label">
          Principal Contact Name <span class="required">*</span>
        </label>
         <input type="text" name="contact_name" required class="form-control" />
      </div>
      <!-- Principal Contact Email -->
      <div class="form-field">
        <label class="field-label">
          Principal Contact Email <span class="required">*</span>
        </label>
         <input type="email" name="contact_email" required class="form-control" />
      </div>
      <!-- Country -->
      <div class="form-field">
        <label class="field-label">
          Country
        </label>
        
        <p class="field-description">
          Select the country where this journal is located, or the country of the mailing address for the journal or publisher.
        </p>
        
        <select name="country" class="form-control">
          <option value="">Select Country</option>
          
          <option value="ID">Indonesia</option>
          
          <option value="US">United States</option>
          
          <option value="GB">United Kingdom</option>
          
          <option value="AU">Australia</option>
          
          <option value="CA">Canada</option>
          
          <option value="SG">Singapore</option>
          
          <option value="MY">Malaysia</option>
        </select>
      </div>
      <!-- Journal Description -->
      <div class="form-field">
        <label class="field-label">
          Journal description
        </label>
        
        <div class="tinymce-wrapper">
          <div class="tinymce-toolbar">
            <button type="button" class="toolbar-btn" title="Bold"><strong>B</strong></button>
            <button type="button" class="toolbar-btn" title="Italic"><em>I</em></button>
            <button type="button" class="toolbar-btn" title="Superscript">x²</button>
            <button type="button" class="toolbar-btn" title="Subscript">x₂</button>
            <button type="button" class="toolbar-btn" title="Link">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </button>
          </div>
           <textarea name="journal_description" rows="8" class="form-control tinymce-editor"></textarea>
        </div>
      </div>
      <!-- Path -->
      <div class="form-field">
        <label class="field-label">
          Path <span class="required">*</span>
        </label>
        
        <div class="input-group">
          <span class="input-group-addon">http://localhost/ojs/</span>
          <input type="text" name="path" required class="form-control" placeholder="journal-name" />
        </div>
        
        <p class="field-description">Provide the path for this journal (e.g., "myjournal").</p>
      </div>
      <!-- Languages -->
      <div class="form-field">
        <label class="field-label">
          Languages <span class="required">*</span>
        </label>
        
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="languages[]" value="en" /> <span>English</span>
          </label>
          
          <label class="checkbox-label">
            <input type="checkbox" name="languages[]" value="id" /> <span>Indonesian</span>
          </label>
        </div>
      </div>
      <!-- Primary Locale -->
      <div class="form-field">
        <label class="field-label">
          Primary locale <span class="required">*</span>
        </label>
        
        <div class="radio-group">
          <label class="radio-label">
            <input type="radio" name="primary_locale" value="en" /> <span>English</span>
          </label>
          
          <label class="radio-label">
            <input type="radio" name="primary_locale" value="id" /> <span>Indonesian</span>
          </label>
        </div>
      </div>
      <!-- Enable -->
      <div class="form-field">
        <label class="field-label">
          Enable
        </label>
        
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="enable_journal" value="1" />
            <span>Enable this journal to appear publicly on the site</span>
          </label>
        </div>
      </div>
      <!-- Submit Button -->
      <div class="form-actions">
        <button type="submit" class="btn-submit">Save</button>
        <a href="/admin/contexts" class="btn-cancel">Cancel</a>
      </div>
    </form>
  </div>
</div>

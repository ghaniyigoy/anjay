<div class="settings-page">
  <header class="settings-head">
    <div class="settings-breadcrumb">
      <a href="/admin">Administration</a>
      <span class="settings-breadcrumb-sep">/</span>
      <span>Jobs</span>
    </div>

    <div class="settings-head-row">
      <h1 class="settings-title">Jobs</h1>

      <div class="system-info-actions">
        <a href="/admin/jobs" class="btn-settings-secondary is-active">View Jobs</a>
        <a href="/admin/failedJobs" class="btn-settings-secondary">View Failed Jobs</a>
      </div>
    </div>

    <p class="settings-page-description">
      View all of the queued jobs in the system and track failed attempts.
    </p>
  </header>

  <div class="settings-main">
    <div class="settings-content jobs-content">
      <section class="settings-panel">
        <div class="settings-panel-head">
          <h2 class="settings-panel-title">View queued jobs</h2>

          <p class="settings-panel-description">
            There's a total of <strong>{length(queued_jobs())}</strong> job(s) on the queue.
          </p>
        </div>

        <div class="settings-table-wrap">
          <table class="settings-table jobs-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Job</th>
                <th>Queue</th>
                <th>Attempts</th>
                <th>Created At</th>
              </tr>
            </thead>
            <tbody>
              <%= for job <- queued_jobs() do %>
                <tr>
                  <td class="jobs-id">{job.id}</td>
                  <td class="jobs-name">{job.display_name}</td>
                  <td>
                    <span class="settings-status">{job.queue}</span>
                  </td>
                  <td class="jobs-attempts">{job.attempts}</td>
                  <td class="jobs-date">{job.created_at}</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%= if length(queued_jobs()) == 0 do %>
          <div class="settings-table-empty">No jobs are currently queued.</div>
        <% end %>
      </section>
    </div>
  </div>
</div>

<div class="author-dashboard-container">
  <!-- Sidebar -->
  <aside class="author-sidebar">
    <div class="sidebar-section">
      <div class="sidebar-header" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>

          <polyline points="14 2 14 8 20 8"></polyline>

          <line x1="16" y1="13" x2="8" y2="13"></line>

          <line x1="16" y1="17" x2="8" y2="17"></line>

          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-title">My Submissions as Author</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <ul class="sidebar-menu">
        <%= for view <- @views do %>
          <li class={if @current_view == view.id, do: "active"}>
            <a href={"/dashboard/mySubmissions?currentViewId=#{view.id}"}>
              <span class="badge">{Enum.count(@all_submissions, &(&1.status == view.status))}</span>
              {view.label}
            </a>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="sidebar-footer">
      <a href="/submission/new" class="btn-new-submission">Start A New Submission</a>
    </div>
  </aside>
  <!-- Main Content -->
  <div class="author-main-content">
    <h1 class="page-heading">
      {view_label(@views, @current_view)} ({length(@submissions)})
    </h1>

    <div class="content-toolbar">
      <div class="toolbar-left">
        <button class="btn-filter">Filters</button> <button class="btn-more">···</button>
      </div>

      <div class="toolbar-right">
        <div class="search-box">
          <svg
            class="search-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle>

            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>

          <input
            type="text"
            placeholder="Search submissions, ID, authors, ..."
            class="search-input"
          />
        </div>
      </div>
    </div>

    <div class="submissions-table-wrapper">
      <table class="submissions-table">
        <thead>
          <tr>
            <th class="col-id">
              ID
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 15l5 5 5-5"></path>

                <path d="M7 9l5-5 5 5"></path>
              </svg>
            </th>

            <th class="col-submissions">SUBMISSIONS</th>

            <th class="col-stage">STAGE</th>

            <th class="col-editorial">EDITORIAL ACTIVITY</th>

            <th class="col-actions">ACTIONS</th>
          </tr>
        </thead>

        <tbody>
          <%= if length(@submissions) == 0 do %>
            <tr>
              <td colspan="5" class="no-items">No Items</td>
            </tr>
          <% else %>
            <%= for submission <- @submissions do %>
              <tr>
                <td class="col-id">{submission.id}</td>

                <td class="col-submissions">
                  <div class="submission-info">
                    <span class="submission-author">{submission.author_username}</span>
                    <span class="submission-title">— {submission.title || "Untitled Submission"}</span>
                  </div>
                </td>

                <td class="col-stage">
                  <span class="stage-indicator">
                    <span class="stage-dot stage-submission"></span> Submission
                  </span>
                </td>

                <td class="col-editorial"></td>

                <td class="col-actions">
                  <%= if submission.status == :incomplete do %>
                    <a
                      href={"/submission/#{submission.id}?tab=details"}
                      class="btn-view btn-continue"
                    >Continue</a>
                  <% else %>
                    <a href={"/submission/#{submission.id}"} class="btn-view">View</a>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>

      <div class="table-footer">
        Showing <strong>1 to {max(1, length(@submissions))}</strong>
        of <strong>{length(@submissions)}</strong>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleSidebarSection(header) {
    var menu = header.nextElementSibling;
    var arrow = header.querySelector('.sidebar-arrow');
    if (menu.style.display === 'none') {
      menu.style.display = 'block';
      arrow.style.transform = 'rotate(0deg)';
    } else {
      menu.style.display = 'none';
      arrow.style.transform = 'rotate(-90deg)';
    }
  }
</script>

<main class="submission-page">
  <div class="submission-card">
    <h1 class="submission-title">Make a Submission</h1>

    <section class="submission-section">
      <h2 class="submission-section-title">Before you begin</h2>

      <p class="submission-paragraph">
        Thank you for submitting to the {assigns[:journal_title] || "title"}. You will be asked to
        upload files, identify co-authors, and provide information such as the title and abstract.
      </p>

      <p class="submission-paragraph">
        Please read our <a href="/informatika/about/submissions">Submission Guidelines</a>
        if you have not done so already. When filling out the forms, provide as many details as
        possible in order to help our editors evaluate your work.
      </p>

      <p class="submission-paragraph">
        Once you begin, you can save your submission and come back to it later. You will be able to
        review and correct any information before you submit.
      </p>
    </section>

    <form
      id="submission-start-form"
      class="submission-form"
      method="POST"
      action="/submission/create"
      novalidate
    >
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

      <div class="submission-field" id="title-field">
        <label for="submission-title" class="submission-label">Title *</label>
        <input
          type="text"
          id="submission-title"
          name="submission[title]"
          class="submission-input"
          value={assigns[:title] || ""}
          autocomplete="off"
        />
        <p class="submission-error" data-error-for="title" role="alert"></p>
      </div>

      <fieldset class="submission-fieldset" id="checklist-fieldset">
        <legend class="submission-legend">Submission Checklist *</legend>

        <p class="submission-help">
          All submissions must meet the following requirements.
        </p>

        <ul class="submission-bullets">
          <li>
            This submission meets the requirements outlined in the <a href="/informatika/about/submissions">Author Guidelines</a>.
          </li>
          <li>This submission has not been previously published, nor is it a consideration.</li>
          <li>All references have been checked for accuracy and completeness.</li>
          <li>All tables and figures have been numbered and labeled.</li>
          <li>
            Permission has been obtained to publish all photos, datasets and other material provided with this submission.
          </li>
        </ul>

        <label class="submission-consent">
          <input type="checkbox" id="checklist-consent" name="submission[checklist]" value="1" />
          <span>Yes, my submission meets all of these requirements.</span>
        </label>
        <p class="submission-error" data-error-for="checklist" role="alert"></p>
      </fieldset>

      <fieldset class="submission-fieldset" id="privacy-fieldset">
        <legend class="submission-legend">Privacy Consent *</legend>

        <label class="submission-consent">
          <input
            type="checkbox"
            id="privacy-consent"
            name="submission[privacy_consent]"
            value="1"
          />
          <span>
            Yes, I agree to have my data collected and stored according to the <a href="/informatika/about/privacy">privacy statement</a>.
          </span>
        </label>
        <p class="submission-error" data-error-for="privacy" role="alert"></p>
      </fieldset>

      <div class="submission-alert" id="submission-alert" role="alert" hidden>
        <strong>Your submission is incomplete.</strong>
        <p>Please correct the highlighted fields below before continuing.</p>
      </div>

      <%= if assigns[:form_error] do %>
        <div class="submission-alert" role="alert">
          <strong>Unable to begin your submission.</strong>
          <p>{@form_error}</p>
        </div>
      <% end %>

      <button type="submit" class="submission-btn" id="begin-submission-btn">
        Begin Submission
      </button>
    </form>
  </div>
</main>

<script>
  (function () {
    var form = document.getElementById('submission-start-form');
    if (!form) return;

    var titleInput = document.getElementById('submission-title');
    var checklistBox = document.getElementById('checklist-consent');
    var privacyBox = document.getElementById('privacy-consent');
    var alertBox = document.getElementById('submission-alert');

    var fields = [
      { id: 'title', input: titleInput, field: document.getElementById('title-field') },
      { id: 'checklist', input: checklistBox, field: document.getElementById('checklist-fieldset') },
      { id: 'privacy', input: privacyBox, field: document.getElementById('privacy-fieldset') }
    ];

    var messages = {
      title: 'Title is required.',
      checklist: 'You must confirm that your submission meets all of these requirements.',
      privacy: 'You must agree to the privacy statement before submitting.'
    };

    function errorEl(id) {
      return form.querySelector('[data-error-for="' + id + '"]');
    }

    function isValid(field) {
      if (field.id === 'title') {
        return String(titleInput.value || '').trim() !== '';
      }
      return field.input.checked;
    }

    function showError(field, show) {
      var el = errorEl(field.id);
      var box = field.field;
      if (el) el.textContent = show ? messages[field.id] : '';
      if (box) box.classList.toggle('invalid', show);
      return show;
    }

    function validateAll() {
      var ok = true;
      fields.forEach(function (field) {
        if (showError(field, !isValid(field))) ok = false;
      });
      return ok;
    }

    function clearErrors() {
      fields.forEach(function (field) {
        showError(field, false);
      });
      if (alertBox) alertBox.hidden = true;
    }

    titleInput.addEventListener('input', clearErrors);
    checklistBox.addEventListener('change', clearErrors);
    privacyBox.addEventListener('change', clearErrors);

    form.addEventListener('submit', function (e) {
      var ok = validateAll();
      if (alertBox) alertBox.hidden = ok;
      if (!ok) {
        e.preventDefault();
        var firstInvalid = fields.find(function (field) { return !isValid(field); });
        if (firstInvalid && firstInvalid.input) firstInvalid.input.focus();
      }
    });
  })();
</script>

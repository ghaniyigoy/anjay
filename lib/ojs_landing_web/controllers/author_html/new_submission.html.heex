<div class="author-dashboard-container">
  <!-- Sidebar -->
  <aside class="author-sidebar">
    <div class="sidebar-section">
      <div class="sidebar-header" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>

          <polyline points="14 2 14 8 20 8"></polyline>

          <line x1="16" y1="13" x2="8" y2="13"></line>

          <line x1="16" y1="17" x2="8" y2="17"></line>

          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-title">My Submissions as Author</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <ul class="sidebar-menu">
        <%= for view <- @views do %>
          <li class={if @current_view == view.id, do: "active"}>
            <a href={"/dashboard/mySubmissions?currentViewId=#{view.id}"}>
              <span class="badge">{Enum.count(@all_submissions, &(&1.status == view.status))}</span> {view.label}
            </a>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="sidebar-footer">
      <a href="/submission/new" class="btn-new-submission">Start A New Submission</a>
    </div>
  </aside>
  <!-- Main content -->
  <div class="author-main-content ojs-wizard-page">
    <!-- Breadcrumb (OJS PKP style) -->
    <nav class="ojs-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/dashboard">Dashboard</a></li>

        <li><a href="/dashboard/mySubmissions">My Submissions</a></li>

        <li aria-current="page">New Submission</li>
      </ol>
    </nav>

    <h1 class="ojs-wizard-title">Start A New Submission</h1>
    <!-- Wizard steps (OJS PKP) -->
    <div class="ojs-wizard-steps" role="list">
      <div class="ojs-step is-current" role="listitem">
        <span class="ojs-step-number">1</span> <span class="ojs-step-label">Prepare</span>
      </div>

      <div class="ojs-step" role="listitem">
        <span class="ojs-step-number">2</span> <span class="ojs-step-label">Upload</span>
      </div>

      <div class="ojs-step" role="listitem">
        <span class="ojs-step-number">3</span> <span class="ojs-step-label">Metadata</span>
      </div>

      <div class="ojs-step" role="listitem">
        <span class="ojs-step-number">4</span> <span class="ojs-step-label">Confirmation</span>
      </div>
    </div>

    <div class="ojs-wizard-layout">
      <!-- Main form -->
      <div class="ojs-wizard-main">
        <form
          class="ojs-wizard-form"
          method="POST"
          action="/submission/create"
          id="new-submission-form"
        >
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <!-- Choose a Section -->
          <div class="ojs-form-block">
            <h2 class="ojs-block-title">Choose a Section</h2>

            <p class="ojs-block-help">
              Pilih bagian jurnal yang paling sesuai dengan makalah Anda.
            </p>

            <select class="ojs-select" id="submission-section" name="submission[section]">
              <%= for section <- ["Artikel Penelitian", "Tinjauan Literatur", "Studi Kasus", "Laporan Riset"] do %>
                <option value={section}>{section}</option>
              <% end %>
            </select>
          </div>
          <!-- Submission Requirements -->
          <div class="ojs-form-block">
            <h2 class="ojs-block-title">Submission Requirements</h2>

            <p class="ojs-block-help">
              Anda harus menyetujui setiap pernyataan di bawah ini untuk mengirimkan naskah.
            </p>

            <ul class="ojs-checklist">
              <%= for {text, type} <- submission_checklist() do %>
                <li>
                  <label class="ojs-checklist-item">
                    <input
                      type="checkbox"
                      class="ojs-checklist-check"
                      data-required={if type == :required, do: "true", else: "false"}
                    />
                    <span class="ojs-checklist-text">
                      {text}
                    </span>
                  </label>
                </li>
              <% end %>
            </ul>
          </div>
          <!-- Comments for the Editor -->
          <div class="ojs-form-block">
            <h2 class="ojs-block-title">Comments for the Editor</h2>

            <p class="ojs-block-help">
              (Opsional) Catatan yang hanya terlihat oleh tim editorial.
            </p>
            <textarea
              class="ojs-textarea"
              id="comments-for-editor"
              name="comments_for_editor"
              placeholder="Tulis komentar untuk editor (opsional)..."
            ></textarea>
          </div>
          <!-- Privacy Statement -->
          <div class="ojs-form-block">
            <h2 class="ojs-block-title">Privacy Statement</h2>

            <div class="ojs-privacy-box">
              <p class="ojs-privacy-text">
                Nama dan alamat email yang dimasukkan di situs jurnal ini hanya akan digunakan untuk
                tujuan yang disebutkan pada jurnal ini dan tidak akan digunakan untuk tujuan atau
                pihak lain mana pun. Silakan baca
                <a href="/informatika/about/privacy">Kebijakan Privasi</a>
                kami.
              </p>
            </div>
          </div>

          <div class="ojs-wizard-actions">
            <button
              type="submit"
              class="btn-ojs-primary"
              id="start-submission-btn"
              disabled
            >
              Save and Continue
            </button>
          </div>
        </form>
      </div>
      <!-- Side panels -->
      <div class="ojs-wizard-side">
        <div class="ojs-side-block">
          <h2 class="ojs-block-title">What Happens Next?</h2>

          <ol class="ojs-prep-steps">
            <li>Isi detail makalah: judul, abstrak, bagian, dan kata kunci.</li>

            <li>Unggah berkas naskah dan berkas pendukung.</li>

            <li>Daftarkan kontributor beserta afiliasi dan email.</li>

            <li>Pilih editor yang akan menangani submission.</li>

            <li>Tinjau kembali seluruh informasi sebelum dikirim ke editor.</li>
          </ol>
        </div>

        <div class="ojs-side-block">
          <h2 class="ojs-block-title">For Contributors</h2>

          <ul class="ojs-side-links">
            <li>
              <a href="/informatika/about/submissions">Panduan Penyerahan</a>
            </li>

            <li>
              <a href="/informatika/about/contact">Hubungi Editorial Office</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleSidebarSection(header) {
    var menu = header.nextElementSibling;
    var arrow = header.querySelector('.sidebar-arrow');
    if (menu.style.display === 'none') {
      menu.style.display = 'block';
      arrow.style.transform = 'rotate(0deg)';
    } else {
      menu.style.display = 'none';
      arrow.style.transform = 'rotate(-90deg)';
    }
  }

  (function () {
    var requiredChecks = Array.prototype.slice.call(
      document.querySelectorAll('.ojs-checklist-check[data-required="true"]')
    );
    var btn = document.getElementById('start-submission-btn');

    if (!btn || !requiredChecks.length) return;

    function updateState() {
      var checked = requiredChecks.filter(function (el) { return el.checked; }).length;
      btn.disabled = checked !== requiredChecks.length;
    }

    requiredChecks.forEach(function (el) {
      el.addEventListener('change', updateState);
    });

    updateState();
  })();
</script>

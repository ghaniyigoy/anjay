<div class="editor-dashboard-container doi-article-page">
  <!-- Sidebar -->
  <aside class="editor-sidebar">
    <div class="sidebar-section">
      <a href="/dashboard/editorial" class="sidebar-header sidebar-header-link">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="3" y="3" width="7" height="9" rx="1"></rect>

          <rect x="14" y="3" width="7" height="5" rx="1"></rect>

          <rect x="14" y="12" width="7" height="9" rx="1"></rect>

          <rect x="3" y="16" width="7" height="5" rx="1"></rect>
        </svg>
        <span class="sidebar-title">Dasbor Editor</span>
      </a>
    </div>

    <div class="sidebar-section">
      <a
        href={OjsLandingWeb.EditorHTML.journal_manage_issues_path()}
        class="sidebar-header sidebar-header-link"
      >
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
          </path>

          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>

          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <span class="sidebar-title">Terbitan</span>
      </a>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-header doi-sidebar-active" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle>

          <line x1="2" y1="12" x2="22" y2="12"></line>

          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
          </path>
        </svg>
        <span class="sidebar-title">DOI</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          style="transform: rotate(0deg)"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <ul class="sidebar-menu" style="display: block">
        <li>
          <a href={OjsLandingWeb.EditorHTML.journal_dois_path()}>
            <svg
              class="sidebar-icon"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="3"></circle>

              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
              </path>
            </svg>
            Pengaturan
          </a>
        </li>

        <li>
          <a href={OjsLandingWeb.EditorHTML.journal_stats_path()}>
            <svg
              class="sidebar-icon"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="18" y1="20" x2="18" y2="10"></line>

              <line x1="12" y1="20" x2="12" y2="4"></line>

              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            Statistik
          </a>
        </li>

        <li>
          <a href="#">
            <svg
              class="sidebar-icon"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="3" width="7" height="7" rx="1"></rect>

              <rect x="14" y="3" width="7" height="7" rx="1"></rect>

              <rect x="14" y="14" width="7" height="7" rx="1"></rect>

              <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            </svg>
            Perangkat
          </a>
        </li>

        <li>
          <a href="#">
            <svg
              class="sidebar-icon"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            Administrasi
          </a>
        </li>
      </ul>
    </div>
  </aside>
  <!-- Main Content -->
  <div class="editor-main-content doi-article-main">
    <!-- Warning bar -->
    <div class="doi-warning-bar">
      <svg
        class="doi-warning-icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z">
        </path>

        <line x1="12" y1="9" x2="12" y2="13"></line>

        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>

      <span>
        DOI tidak dapat dibuat kecuali jika anda menyediakan prefiks DOI yang dibuat. Tambahkan prefiks DOI.
      </span>
    </div>

    <nav class="ojs-submission-tabs doi-article-tabs" aria-label="Objek DOI">
      <a href="#articles" class="active">Artikel
      <span class="ojs-tab-count">{length(@articles)}</span></a> <a href="#issues">Terbitan</a>
      <a href="#galleys">Galeri</a>
    </nav>

    <h1 class="page-heading">Artikel</h1>

    <div class="doi-article-toolbar">
      <div class="doi-article-toolbar-row">
        <div class="doi-toolbar-left">
          <span class="doi-tab-label">DOI Artikel</span>
        </div>

        <div class="doi-toolbar-right">
          <div class="search-box">
            <svg
              class="search-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="8"></circle>

              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Cari" class="search-input" />
          </div>

          <button type="button" class="btn-settings-secondary doi-bulk-actions" disabled>
            Tindakan Massal
          </button>
        </div>
      </div>
    </div>

    <div class="doi-layout doi-article-layout">
      <!-- Filters sidebar -->
      <aside class="doi-filters doi-article-filters">
        <h3 class="doi-filters-title">
          Filter
          <svg
            class="doi-filter-help"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>

            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>

            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </h3>

        <div class="doi-filter-group">
          <h4 class="doi-filter-label">Status</h4>
          <a href="#" class="doi-filter-link">Membutuhkan DOI ({@status_counts.needs_doi})</a>
          <a href="#" class="doi-filter-link">DOI Ditetapkan ({@status_counts.assigned})</a>
        </div>

        <div class="doi-filter-group">
          <h4 class="doi-filter-label">Pendaftaran</h4>

          <a href="#" class="doi-filter-link">Tidak terdaftar ({@registration_counts.unregistered})</a>
          <a href="#" class="doi-filter-link">Dikirimkan ({@registration_counts.submitted})</a>
          <a href="#" class="doi-filter-link">Didaftarkan ({@registration_counts.registered})</a>
          <a href="#" class="doi-filter-link">Terdapat Eror ({@registration_counts.error})</a>
          <a href="#" class="doi-filter-link">Membutuhkan Sinkronisasi ({@registration_counts.stale})</a>
        </div>

        <div class="doi-filter-group">
          <h4 class="doi-filter-label">Terbitan</h4>

          <input
            type="text"
            class="settings-input doi-filter-issue-input"
            placeholder="Cari terbitan..."
          />
        </div>
      </aside>
      <!-- List panel -->
      <div class="doi-list-panel">
        <div class="submissions-table-wrapper doi-table-wrap">
          <table class="submissions-table doi-table doi-article-table">
            <thead>
              <tr>
                <th class="doi-col-select">
                  <input type="checkbox" class="doi-select-all" aria-label="Pilih semua" />
                </th>

                <th>Judul</th>

                <th class="doi-col-publication">Publikasi</th>
              </tr>
            </thead>

            <tbody>
              <%= for item <- @articles do %>
                <tr id={"doi-article-row-#{item.id}"}>
                  <td class="doi-col-select">
                    <input type="checkbox" aria-label={"Pilih #{item.title}"} />
                  </td>

                  <td>
                    <div class="doi-article-title-cell">
                      <span class="doi-item-title">{item.title}</span>
                      <span class="doi-article-id">{item.id}</span>
                    </div>

                    <div class="doi-item-meta">
                      <%= if item.doi do %>
                        <span class="doi-code">{item.doi}</span>
                      <% else %>
                        <span class="doi-code-empty">—</span>
                      <% end %>
                    </div>
                  </td>

                  <td class="doi-col-publication">
                    <select
                      class="doi-publication-select"
                      aria-label="Status publikasi"
                      data-published={item.published}
                    >
                      <option value="published" selected={item.published}>Diterbitkan</option>

                      <option value="unpublished" selected={!item.published}>
                        Tidak Diterbitkan
                      </option>
                    </select>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <div class="table-footer">
            Showing <strong>0 to {length(@articles)}</strong>
            of <strong>{length(@articles)}</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleSidebarSection(header) {
    var menu = header.nextElementSibling;
    var arrow = header.querySelector('.sidebar-arrow');
    if (menu.style.display === 'none') {
      menu.style.display = 'block';
      arrow.style.transform = 'rotate(0deg)';
    } else {
      menu.style.display = 'none';
      arrow.style.transform = 'rotate(-90deg)';
    }
  }
</script>

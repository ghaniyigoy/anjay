<div class="editor-dashboard-container">
  <!-- Sidebar -->
  <aside class="editor-sidebar">
    <div class="sidebar-section">
      <div class="sidebar-header" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>

          <line x1="9" y1="9" x2="15" y2="9"></line>

          <line x1="9" y1="13" x2="15" y2="13"></line>

          <line x1="9" y1="17" x2="13" y2="17"></line>
        </svg>
        <span class="sidebar-title">Editor Dashboard</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          style="transform: rotate(-90deg)"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <ul class="sidebar-menu" style="display: none">
        <li class={if @current_view == "assigned-to-me", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=assigned-to-me">
            <span class={[
              "badge",
              badge_class(
                "assigned-to-me",
                Enum.count(@all_submissions, fn s -> s.assigned_to == @user.username end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.assigned_to == @user.username end)}</span>
            Assigned to me
          </a>
        </li>

        <li class={if @current_view == "active", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=active">
            <span class={[
              "badge",
              badge_class(
                "active",
                Enum.count(@all_submissions, fn s -> s.status in [:active, :under_review] end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.status in [:active, :under_review] end)}</span>
            Active submissions
          </a>
        </li>

        <li class={if @current_view == "needs-editor", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=needs-editor">
            <span class={[
              "badge",
              badge_class(
                "needs-editor",
                Enum.count(@all_submissions, fn s -> s.stage == :needs_editor end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :needs_editor end)}</span>
            Needs editor
          </a>
        </li>

        <li class={if @current_view == "initial-review", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=initial-review">
            <span class={[
              "badge",
              badge_class(
                "initial-review",
                Enum.count(@all_submissions, fn s -> s.stage == :initial_review end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :initial_review end)}</span>
            All in submission stage
          </a>
        </li>

        <li class={if @current_view == "needs-reviews", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=needs-reviews">
            <span class={[
              "badge",
              badge_class(
                "needs-reviews",
                Enum.count(@all_submissions, fn s -> s.stage == :needs_reviews end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :needs_reviews end)}</span>
            Needs reviews
          </a>
        </li>

        <li class={if @current_view == "awaiting-reviews", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=awaiting-reviews">
            <span class={[
              "badge",
              badge_class(
                "awaiting-reviews",
                Enum.count(@all_submissions, fn s -> s.stage == :awaiting_reviews end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :awaiting_reviews end)}</span>
            Awaiting reviews
          </a>
        </li>

        <li class={if @current_view == "reviews-submitted", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=reviews-submitted">
            <span class={[
              "badge",
              badge_class(
                "reviews-submitted",
                Enum.count(@all_submissions, fn s -> s.stage == :reviews_submitted end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :reviews_submitted end)}</span>
            Reviews submitted
          </a>
        </li>

        <li class={if @current_view == "reviews-overdue", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=reviews-overdue">
            <span class={[
              "badge",
              badge_class(
                "reviews-overdue",
                Enum.count(@all_submissions, fn s -> s.reviews_overdue end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.reviews_overdue end)}</span>
            Reviews overdue
          </a>
        </li>

        <li class={if @current_view == "revisions-submitted", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=revisions-submitted">
            <span class={[
              "badge",
              badge_class(
                "revisions-submitted",
                Enum.count(@all_submissions, fn s -> s.stage == :revisions_submitted end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :revisions_submitted end)}</span>
            Author revisions submitted
          </a>
        </li>

        <li class={if @current_view == "external-review", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=external-review">
            <span class={[
              "badge",
              badge_class(
                "external-review",
                Enum.count(@all_submissions, fn s -> s.stage == :external_review end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :external_review end)}</span>
            All in review stage
          </a>
        </li>

        <li class={if @current_view == "copyediting", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=copyediting">
            <span class={[
              "badge",
              badge_class(
                "copyediting",
                Enum.count(@all_submissions, fn s -> s.stage == :copyediting end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :copyediting end)}</span>
            All in copyediting stage
          </a>
        </li>

        <li class={if @current_view == "production", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=production">
            <span class={[
              "badge",
              badge_class(
                "production",
                Enum.count(@all_submissions, fn s -> s.stage == :production end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :production end)}</span>
            All in production stage
          </a>
        </li>

        <li class={if @current_view == "scheduled", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=scheduled">
            <span class={[
              "badge",
              badge_class(
                "scheduled",
                Enum.count(@all_submissions, fn s -> s.status == :scheduled end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.status == :scheduled end)}</span>
            Scheduled for publication
          </a>
        </li>

        <li class={if @current_view == "published", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=published">
            <span class={[
              "badge",
              badge_class(
                "published",
                Enum.count(@all_submissions, fn s -> s.status == :published end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.status == :published end)}</span>
            Published
          </a>
        </li>

        <li class={if @current_view == "declined", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=declined">
            <span class={[
              "badge",
              badge_class(
                "declined",
                Enum.count(@all_submissions, fn s -> s.status == :declined end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.status == :declined end)}</span>
            Declined
          </a>
        </li>
      </ul>
    </div>

    <div class="sidebar-section">
      <a href={journal_manage_issues_path()} class="sidebar-header sidebar-header-link">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
          </path>

          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>

          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <span class="sidebar-title">Issues</span>
      </a>
    </div>

    <div class="sidebar-section">
      <a href={journal_dois_path()} class="sidebar-header sidebar-header-link">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle>

          <line x1="2" y1="12" x2="22" y2="12"></line>

          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
          </path>
        </svg>
        <span class="sidebar-title">DOIs</span>
      </a>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-header" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="3"></circle>

          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
          </path>
        </svg>
        <span class="sidebar-title">Settings</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          style="transform: rotate(-90deg)"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <ul class="sidebar-menu" style="display: none">
        <%= for {label, path} <- journal_settings_links() do %>
          <li>
            <a href={path}>
              <span class="badge badge-zero">{""}</span> {label}
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  </aside>
  <!-- Main Content -->
  <div class="editor-main-content">
    <h1 class="page-heading">
      {String.capitalize(String.replace(@current_view, "-", " "))} ({length(@submissions)})
    </h1>

    <div class="content-toolbar">
      <div class="toolbar-left">
        <button class="btn-filter">Filters</button> <button class="btn-more">···</button>
      </div>

      <div class="toolbar-right">
        <div class="search-box">
          <svg
            class="search-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle>

            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>

          <input
            type="text"
            placeholder="Search submissions, ID, authors, ..."
            class="search-input"
          />
        </div>
      </div>
    </div>

    <div class="submissions-table-wrapper">
      <table class="submissions-table">
        <thead>
          <tr>
            <th class="col-id">
              ID
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 15l5 5 5-5"></path>

                <path d="M7 9l5-5 5 5"></path>
              </svg>
            </th>

            <th class="col-submissions">SUBMISSIONS</th>

            <th class="col-stage">STAGE</th>

            <th class="col-days">
              DAYS
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 15l5 5 5-5"></path>

                <path d="M7 9l5-5 5 5"></path>
              </svg>
            </th>

            <th class="col-editorial">EDITORIAL ACTIVITY</th>

            <th class="col-actions">ACTIONS</th>
          </tr>
        </thead>

        <tbody>
          <%= if length(@submissions) == 0 do %>
            <tr>
              <td colspan="6" class="no-items">No Items</td>
            </tr>
          <% else %>
            <%= for submission <- @submissions do %>
              <tr>
                <td class="col-id">{submission.id}</td>

                <td class="col-submissions">
                  <div class="submission-info">
                    <span class="submission-author">{submission.author}</span>
                    <span class="submission-title">— {submission.title}</span>
                  </div>
                </td>

                <td class="col-stage">
                  <span class="stage-indicator">
                    <span
                      class="stage-dot"
                      style={["background-color: ", stage_color(submission.stage)]}
                    ></span> {stage_label(submission.stage)}
                  </span>
                </td>

                <td class="col-days">{submission.days}</td>

                <td class="col-editorial"></td>

                <td class="col-actions">
                  <a href={"/submission/#{submission.id}"} class="btn-view">View</a>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>

      <div class="table-footer">
        Showing <strong>0 to {max(0, length(@submissions))}</strong>
        of <strong>{length(@submissions)}</strong>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleSidebarSection(header) {
    var menu = header.nextElementSibling;
    var arrow = header.querySelector('.sidebar-arrow');
    if (menu.style.display === 'none') {
      menu.style.display = 'block';
      arrow.style.transform = 'rotate(0deg)';
    } else {
      menu.style.display = 'none';
      arrow.style.transform = 'rotate(-90deg)';
    }
  }
</script>

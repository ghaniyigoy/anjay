<div class="editor-dashboard-container">
  <!-- Sidebar -->
  <aside class="editor-sidebar">
    <div class="sidebar-section">
      <div class="sidebar-header" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>

          <line x1="9" y1="9" x2="15" y2="9"></line>

          <line x1="9" y1="13" x2="15" y2="13"></line>

          <line x1="9" y1="17" x2="13" y2="17"></line>
        </svg>
        <span class="sidebar-title">Editor Dashboard</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          style="transform: rotate(-90deg)"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <ul class="sidebar-menu" style="display: none">
        <li class={if @current_view == "assigned-to-me", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=assigned-to-me">
            <span class={[
              "badge",
              badge_class(
                "assigned-to-me",
                Enum.count(@all_submissions, fn s -> s.assigned_to == @user.username end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.assigned_to == @user.username end)}</span>
            Assigned to me
          </a>
        </li>

        <li class={if @current_view == "active", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=active">
            <span class={[
              "badge",
              badge_class(
                "active",
                Enum.count(@all_submissions, fn s -> s.status in [:active, :under_review] end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.status in [:active, :under_review] end)}</span>
            Active submissions
          </a>
        </li>

        <li class={if @current_view == "needs-editor", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=needs-editor">
            <span class={[
              "badge",
              badge_class(
                "needs-editor",
                Enum.count(@all_submissions, fn s -> s.stage == :needs_editor end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :needs_editor end)}</span>
            Needs editor
          </a>
        </li>

        <li class={if @current_view == "initial-review", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=initial-review">
            <span class={[
              "badge",
              badge_class(
                "initial-review",
                Enum.count(@all_submissions, fn s -> s.stage == :initial_review end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :initial_review end)}</span>
            All in submission stage
          </a>
        </li>

        <li class={if @current_view == "needs-reviews", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=needs-reviews">
            <span class={[
              "badge",
              badge_class(
                "needs-reviews",
                Enum.count(@all_submissions, fn s -> s.stage == :needs_reviews end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :needs_reviews end)}</span>
            Needs reviews
          </a>
        </li>

        <li class={if @current_view == "awaiting-reviews", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=awaiting-reviews">
            <span class={[
              "badge",
              badge_class(
                "awaiting-reviews",
                Enum.count(@all_submissions, fn s -> s.stage == :awaiting_reviews end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :awaiting_reviews end)}</span>
            Awaiting reviews
          </a>
        </li>

        <li class={if @current_view == "reviews-submitted", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=reviews-submitted">
            <span class={[
              "badge",
              badge_class(
                "reviews-submitted",
                Enum.count(@all_submissions, fn s -> s.stage == :reviews_submitted end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :reviews_submitted end)}</span>
            Reviews submitted
          </a>
        </li>

        <li class={if @current_view == "reviews-overdue", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=reviews-overdue">
            <span class={[
              "badge",
              badge_class(
                "reviews-overdue",
                Enum.count(@all_submissions, fn s -> s.reviews_overdue end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.reviews_overdue end)}</span>
            Reviews overdue
          </a>
        </li>

        <li class={if @current_view == "revisions-submitted", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=revisions-submitted">
            <span class={[
              "badge",
              badge_class(
                "revisions-submitted",
                Enum.count(@all_submissions, fn s -> s.stage == :revisions_submitted end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :revisions_submitted end)}</span>
            Author revisions submitted
          </a>
        </li>

        <li class={if @current_view == "external-review", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=external-review">
            <span class={[
              "badge",
              badge_class(
                "external-review",
                Enum.count(@all_submissions, fn s -> s.stage == :external_review end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :external_review end)}</span>
            All in review stage
          </a>
        </li>

        <li class={if @current_view == "copyediting", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=copyediting">
            <span class={[
              "badge",
              badge_class(
                "copyediting",
                Enum.count(@all_submissions, fn s -> s.stage == :copyediting end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :copyediting end)}</span>
            All in copyediting stage
          </a>
        </li>

        <li class={if @current_view == "production", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=production">
            <span class={[
              "badge",
              badge_class(
                "production",
                Enum.count(@all_submissions, fn s -> s.stage == :production end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.stage == :production end)}</span>
            All in production stage
          </a>
        </li>

        <li class={if @current_view == "scheduled", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=scheduled">
            <span class={[
              "badge",
              badge_class(
                "scheduled",
                Enum.count(@all_submissions, fn s -> s.status == :scheduled end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.status == :scheduled end)}</span>
            Scheduled for publication
          </a>
        </li>

        <li class={if @current_view == "published", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=published">
            <span class={[
              "badge",
              badge_class(
                "published",
                Enum.count(@all_submissions, fn s -> s.status == :published end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.status == :published end)}</span>
            Published
          </a>
        </li>

        <li class={if @current_view == "declined", do: "active"}>
          <a href="/dashboard/editorial?currentViewId=declined">
            <span class={[
              "badge",
              badge_class(
                "declined",
                Enum.count(@all_submissions, fn s -> s.status == :declined end)
              )
            ]}>{Enum.count(@all_submissions, fn s -> s.status == :declined end)}</span>
            Declined
          </a>
        </li>
      </ul>
    </div>

    <div class="sidebar-section">
      <a href={journal_manage_issues_path()} class="sidebar-header sidebar-header-link">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
          </path>

          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>

          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <span class="sidebar-title">Issues</span>
      </a>
    </div>

    <div class="sidebar-section">
      <a href={journal_dois_path()} class="sidebar-header sidebar-header-link">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle>

          <line x1="2" y1="12" x2="22" y2="12"></line>

          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
          </path>
        </svg>
        <span class="sidebar-title">DOIs</span>
      </a>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-header" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <line x1="18" y1="20" x2="18" y2="10"></line>

          <line x1="12" y1="20" x2="12" y2="4"></line>

          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span class="sidebar-title">Statistics</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          style="transform: rotate(-90deg)"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <ul class="sidebar-menu" style="display: none">
        <%= for {label, path} <- journal_stats_links() do %>
          <li>
            <a href={path}>
              <span class="badge badge-zero">{""}</span> {label}
            </a>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-header" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="3"></circle>

          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
          </path>
        </svg>
        <span class="sidebar-title">Settings</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          style="transform: rotate(-90deg)"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <ul class="sidebar-menu" style="display: none">
        <%= for {label, path} <- journal_settings_links() do %>
          <li>
            <a href={path}>
              <span class="badge badge-zero">{""}</span> {label}
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  </aside>
  <!-- Main Content -->
  <div class="editor-main-content">
    <h1 class="page-heading">
      {String.capitalize(String.replace(@current_view, "-", " "))} ({length(@submissions)})
    </h1>

    <div class="content-toolbar">
      <div class="toolbar-left">
        <button class="btn-filter">Filters</button> <button class="btn-more">···</button>
      </div>

      <div class="toolbar-right">
        <div class="search-box">
          <svg
            class="search-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle>

            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>

          <input
            type="text"
            placeholder="Search submissions, ID, authors, ..."
            class="search-input"
          />
        </div>
      </div>
    </div>

    <div class="submissions-table-wrapper">
      <table class="submissions-table">
        <thead>
          <tr>
            <th class="col-id">
              ID
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 15l5 5 5-5"></path>

                <path d="M7 9l5-5 5 5"></path>
              </svg>
            </th>

            <th class="col-submissions">SUBMISSIONS</th>

            <th class="col-stage">STAGE</th>

            <th class="col-days">
              DAYS
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 15l5 5 5-5"></path>

                <path d="M7 9l5-5 5 5"></path>
              </svg>
            </th>

            <th class="col-editorial">EDITORIAL ACTIVITY</th>

            <th class="col-actions">ACTIONS</th>
          </tr>
        </thead>

        <tbody>
          <%= if length(@submissions) == 0 do %>
            <tr>
              <td colspan="6" class="no-items">No Items</td>
            </tr>
          <% else %>
            <%= for submission <- @submissions do %>
              <tr>
                <td class="col-id">{submission.id}</td>

                <td class="col-submissions">
                  <div class="submission-info">
                    <span class="submission-author">{submission.author}</span>
                    <span class="submission-title">— {submission.title}</span>
                  </div>
                </td>

                <td class="col-stage">
                  <span class="stage-indicator">
                    <span
                      class="stage-dot"
                      style={["background-color: ", stage_color(submission.stage)]}
                    ></span> {stage_label(submission.stage)}
                  </span>
                </td>

                <td class="col-days">{submission.days}</td>

                <td class="col-editorial">
                  <% action = editorial_actions(submission) %>
                  <%= if action do %>
                    <%= if Map.get(action, :modal) do %>
                      <%= if String.starts_with?(action.modal, "assign-reviewers-") do %>
                        <button
                          type="button"
                          class="btn-editorial-action"
                          onclick={"openAddReviewerModal(#{submission.id})"}
                        >{action.label}</button>
                      <% else %>
                        <button
                          type="button"
                          class="btn-editorial-action"
                          onclick={"openAssignEditorModal(#{submission.id})"}
                        >{action.label}</button>
                      <% end %>
                    <% else %>
                      <a href={action.href} class="btn-editorial-action">{action.label}</a>
                    <% end %>
                  <% end %>
                </td>

                <td class="col-actions">
                  <a
                    href={
                      workflow_menu_path(
                        submission.id,
                        @current_view,
                        default_workflow_menu_for_stage(submission.stage)
                      )
                    }
                    class="editorial-view-link"
                  >View</a>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>

      <div class="table-footer">
        Showing <strong>0 to {max(0, length(@submissions))}</strong>
        of <strong>{length(@submissions)}</strong>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleSidebarSection(header) {
    var menu = header.nextElementSibling;
    var arrow = header.querySelector('.sidebar-arrow');
    if (menu.style.display === 'none') {
      menu.style.display = 'block';
      arrow.style.transform = 'rotate(0deg)';
    } else {
      menu.style.display = 'none';
      arrow.style.transform = 'rotate(-90deg)';
    }
  }
</script>

<%!-- Assign Participant Drawer (right slide-in page) --%>
<div id="assign-editor-overlay" class="apd-overlay">
  <div class="apd-panel">
    <div class="apd-header">
      <button
        type="button"
        class="apd-back"
        onclick="closeAssignEditorModal()"
        aria-label="Back"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <h2 class="apd-title">Assign Participant</h2>
      <span class="apd-title-spacer"></span>
    </div>

    <div class="apd-body">
      <div class="apd-heading">Locate a User</div>

      <div class="apd-locate-row">
        <select id="ap-role-filter" class="apd-select" onchange="filterAssignEditorUsers()">
          <option value="editor">Journal Editor</option>
          <option value="section_editor">Section Editor</option>
          <option value="guest_editor">Guest Editor</option>
          <option value="finding_coordinator">Funding coordinator</option>
          <option value="author">Author</option>
          <option value="translator">Translator</option>
        </select>

        <div class="apd-search-wrap">
          <div class="apd-search-box">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              class="apd-search-input"
              id="ap-search-name"
              placeholder="Search"
              oninput="filterAssignEditorUsers()"
            />
          </div>
        </div>
      </div>

      <div class="apd-search-heading">Search User By Name</div>

      <div class="apd-table-wrapper">
        <table class="apd-users-table" id="ap-users-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Assignments</th>
              <th>Affiliation</th>
              <th>Reviewing Interest</th>
            </tr>
          </thead>
          <tbody id="ap-users-tbody"></tbody>
        </table>
        <div class="apd-no-results" id="ap-no-results" style="display:none">
          No users found.
        </div>
      </div>

      <div class="apd-message-section">
        <p class="apd-message-hint">
          Choose a predefined message to use, or fill out the form below.
        </p>
        <label class="apd-message-label">Predefined Message</label>
        <select
          id="ap-predefined-message"
          class="apd-select apd-predefined-select"
          onchange="applyPredefinedMessage(this.value)"
        >
          <option value="">Choose a predefined message...</option>
          <option value="discussion">Discussion (Submission)</option>
          <option value="assign_editor">Assign Editor</option>
        </select>
        <label class="apd-message-label">Message</label>
        <div class="ap-richtext-wrapper">
          <div class="ap-richtext-toolbar">
            <button type="button" class="ap-richtext-btn" data-cmd="bold" title="Bold"><b>B</b></button>
            <button type="button" class="ap-richtext-btn" data-cmd="italic" title="Italic"><i>I</i></button>
            <button type="button" class="ap-richtext-btn" data-cmd="underline" title="Underline"><u>U</u></button>
            <button
              type="button"
              class="ap-richtext-btn"
              data-cmd="insertUnorderedList"
              title="Bullet List"
            >&#8226;</button>
          </div>
          <div class="ap-richtext-editor" id="ap-message-editor" contenteditable="true"></div>
        </div>
      </div>
    </div>

    <div class="apd-footer">
      <button type="button" class="apd-btn-cancel" onclick="closeAssignEditorModal()">Cancel</button>
      <button type="button" class="apd-btn-ok" onclick="submitAssignEditor()">Send</button>
    </div>
  </div>
</div>

<%!-- Hidden form for POST submission --%>
<form
  id="assign-editor-form"
  method="post"
  action="/dashboard/editorial/assign-editor"
  style="display:none"
>
  <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
  <input type="hidden" id="ap-form-submission-id" name="submission_id" value="" />
  <input type="hidden" id="ap-form-role" name="role" value="editor" />
  <input type="hidden" id="ap-form-user-id" name="user_id" value="" />
  <input type="hidden" id="ap-form-username" name="username" value="" />
  <input type="hidden" id="ap-form-message" name="message" value="" />
</form>

<script>
  window.__apUsers = <%= raw(@ap_users_json || "[]") %>;
  window.__apSelectedUserId = null;
  window.__apCurrentSubmissionId = null;

  function openAssignEditorModal(submissionId) {
    window.__apCurrentSubmissionId = submissionId;
    window.__apSelectedUserId = null;
    document.getElementById('ap-form-submission-id').value = submissionId;
    document.getElementById('ap-form-user-id').value = '';
    document.getElementById('ap-form-username').value = '';
    document.getElementById('ap-form-message').value = '';
    document.getElementById('ap-message-editor').innerHTML = '';
    document.getElementById('ap-predefined-message').value = '';
    document.getElementById('ap-search-name').value = '';
    document.getElementById('ap-role-filter').value = 'editor';
    filterAssignEditorUsers();
    document.getElementById('assign-editor-overlay').classList.add('apd-open');
    document.body.style.overflow = 'hidden';
  }

  function closeAssignEditorModal() {
    document.getElementById('assign-editor-overlay').classList.remove('apd-open');
    document.body.style.overflow = '';
  }

  function applyPredefinedMessage(value) {
    var editor = document.getElementById('ap-message-editor');
    if (!value) { return; }
    if (value === 'discussion') {
      editor.innerHTML = '<p>Dear Editor,</p><p>I have submitted my manuscript for consideration. Please let me know if there is anything else you need.</p>';
    } else if (value === 'assign_editor') {
      editor.innerHTML = '<p>You have been assigned as the editor of record for this submission. Please proceed with the editorial workflow.</p>';
    }
  }

  function filterAssignEditorUsers() {
    var role = document.getElementById('ap-role-filter').value;
    var query = document.getElementById('ap-search-name').value.toLowerCase();
    var users = window.__apUsers || [];
    var tbody = document.getElementById('ap-users-tbody');
    var noResults = document.getElementById('ap-no-results');

    var filtered = users.filter(function(u) {
      var matchRole = (role === 'all') || (u.role === role);
      var name = ((u.given_name || '') + ' ' + (u.family_name || '')).toLowerCase();
      var matchQuery = !query || name.indexOf(query) !== -1 || (u.email || '').toLowerCase().indexOf(query) !== -1;
      return matchRole && matchQuery;
    });

    tbody.innerHTML = '';
    if (filtered.length === 0) {
      noResults.style.display = 'block';
    } else {
      noResults.style.display = 'none';
      filtered.forEach(function(u) {
        var name = ((u.given_name || '') + ' ' + (u.family_name || '')).trim() || u.username;
        var tr = document.createElement('tr');
        tr.className = 'apd-user-row';
        tr.setAttribute('data-user-id', u.id);
        tr.setAttribute('data-username', u.username);
        tr.onclick = function() { selectAssignEditorUser(u.id, u.username, name, tr); };
        tr.innerHTML =
          '<td><div class="apd-row-name">' + escapeHtml(name) + '</div><div class="apd-row-email">' + escapeHtml(u.email || '') + '</div></td>' +
          '<td>' + (u.reviews_completed || 0) + '</td>' +
          '<td>' + escapeHtml(u.affiliation || '—') + '</td>' +
          '<td>' + escapeHtml(u.reviewing_interests || '—') + '</td>';
        tbody.appendChild(tr);
      });
    }
  }

  function selectAssignEditorUser(userId, username, name, row) {
    document.querySelectorAll('.apd-user-row').forEach(function(r) { r.classList.remove('apd-user-selected'); });
    row.classList.add('apd-user-selected');
    window.__apSelectedUserId = userId;
    document.getElementById('ap-form-user-id').value = userId;
    document.getElementById('ap-form-username').value = username;
  }

  function submitAssignEditor() {
    if (!window.__apSelectedUserId) {
      alert('Please select a user first.');
      return;
    }
    var editor = document.getElementById('ap-message-editor');
    document.getElementById('ap-form-message').value = editor.innerHTML;
    document.getElementById('ap-form-role').value = document.getElementById('ap-role-filter').value;
    document.getElementById('assign-editor-form').submit();
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  // Initialize richtext toolbar for the modal
  document.querySelectorAll('.ap-richtext-toolbar .ap-richtext-btn').forEach(function(btn) {
    btn.addEventListener('mousedown', function(e) { e.preventDefault(); });
    btn.addEventListener('click', function() {
      var cmd = btn.getAttribute('data-cmd');
      document.getElementById('ap-message-editor').focus();
      document.execCommand(cmd, false, null);
    });
  });

  // Close modal on overlay click
  document.getElementById('assign-editor-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeAssignEditorModal();
  });

  // Close modal on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeAssignEditorModal();
  });
</script>

<%!-- Add Reviewer Slide-in Page --%>
<div id="add-reviewer-overlay" class="ar-overlay">
  <div class="ar-panel">
    <div class="ar-header">
      <button
        type="button"
        class="ar-back"
        onclick="closeAddReviewerModal()"
        aria-label="Back"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <h2 class="ar-title">Add Reviewer</h2>
      <span class="ar-title-spacer"></span>
    </div>

    <div class="ar-body">
      <%!-- Submission Author List --%>
      <div class="ar-author-panel">
        <div class="ar-panel-heading">Submission Author List</div>
        <div class="ar-author-entry">
          <span class="ar-author-avatar" id="ar-author-avatar">AU</span>
          <div class="ar-author-info">
            <strong id="ar-author-name">—</strong>
            <span id="ar-author-title" class="ar-author-title">—</span>
          </div>
        </div>
      </div>

      <%!-- Locate a Reviewer --%>
      <div class="ar-locate-head">
        <h3 class="ar-section-title">Locate a Reviewer</h3>
        <div class="ar-locate-actions">
          <div class="ar-search-box">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              class="ar-search-input"
              placeholder="Search"
              id="ar-search-input"
              oninput="arFilterReviewers()"
            />
          </div>
          <button
            type="button"
            class="ar-btn-filters"
            id="ar-btn-filters"
            onclick="arToggleFilters()"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            Filters
          </button>
        </div>
      </div>

      <%!-- Content: filters sidebar + reviewer list --%>
      <div class="ar-content-wrap">
        <%!-- Filters sidebar --%>
        <div class="ar-filters-sidebar" id="ar-filters-sidebar">
          <div class="ar-filters-head">
            <h4 class="ar-filters-title">Filters</h4>
            <div class="ar-filters-actions">
              <span class="ar-filters-count" id="ar-filters-count"></span>
              <button type="button" class="ar-filters-reset" onclick="arResetFilters()">Reset</button>
            </div>
          </div>

          <div class="ar-active-filters" id="ar-active-filters"></div>

          <div class="ar-filters-group">
            <div class="ar-filter-row">
              <label class="ar-filter-label">Rated at least</label>
              <button
                type="button"
                class="ar-filter-add"
                id="ar-add-rated"
                onclick="arAddFilter('rated')"
              >+</button>
            </div>
            <div class="ar-filter-sub">
              Rate this reviewer's completed reviews on a scale of 1 to 5.
            </div>

            <div class="ar-filter-row">
              <label class="ar-filter-label">Reviews completed</label>
              <button
                type="button"
                class="ar-filter-add"
                id="ar-add-completed"
                onclick="arAddFilter('completed')"
              >+</button>
            </div>
            <div class="ar-filter-sub">
              The number of reviews this reviewer has completed.
            </div>

            <div class="ar-filter-row">
              <label class="ar-filter-label">Days since last review assigned</label>
              <button
                type="button"
                class="ar-filter-add"
                id="ar-add-days"
                onclick="arAddFilter('days')"
              >+</button>
            </div>
            <div class="ar-filter-sub">
              Days since this reviewer's last review was assigned.
            </div>

            <div class="ar-filter-row">
              <label class="ar-filter-label">Active reviews currently assigned</label>
              <button
                type="button"
                class="ar-filter-add"
                id="ar-add-active"
                onclick="arAddFilter('active')"
              >+</button>
            </div>
            <div class="ar-filter-sub">
              Reviews this reviewer is currently working on.
            </div>

            <div class="ar-filter-row">
              <label class="ar-filter-label">Average days to complete review</label>
              <button
                type="button"
                class="ar-filter-add"
                id="ar-add-avg"
                onclick="arAddFilter('avg')"
              >+</button>
            </div>
            <div class="ar-filter-sub">
              Average number of days this reviewer takes to complete a review.
            </div>
          </div>
        </div>

        <%!-- Reviewer list --%>
        <div class="ar-reviewer-list" id="ar-reviewer-list">
          <div class="ar-no-results" id="ar-no-results" style="display:none">
            No reviewers match your search.
          </div>
        </div>
      </div>
    </div>

    <%!-- Alternative Actions Footer --%>
    <div class="ar-footer">
      <button type="button" class="ar-btn-create" onclick="arOpenCreateReviewer()">Create New Reviewer</button>
      <button type="button" class="ar-btn-enroll" onclick="arOpenEnrollUser()">Enroll Existing User</button>
    </div>
  </div>
</div>

<%!-- Hidden form for reviewer assignment POST --%>
<form
  id="assign-reviewer-form"
  method="post"
  style="display:none"
>
  <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
  <input type="hidden" id="ar-form-current-view" name="currentViewId" value={@current_view} />
  <input type="hidden" id="ar-form-reviewer-name" name="reviewer_name" value="" />
  <input type="hidden" id="ar-form-submission-id" name="submission_id" value="" />
</form>

<script>
  window.__arReviewers = <%= raw(@ap_users_json || "[]") %>;
  window.__arSubmissions = <%= raw(@ap_submissions_json || "[]") %>;
  window.__arCurrentSubmissionId = null;

  function openAddReviewerModal(submissionId) {
    window.__arCurrentSubmissionId = submissionId;
    document.getElementById('assign-reviewer-form').action =
      '/dashboard/editorial/' + submissionId + '/assign-reviewer';
    document.getElementById('ar-form-reviewer-name').value = '';

    var sub = (window.__arSubmissions || []).find(function(s) { return String(s.id) === String(submissionId); });
    if (sub) {
      var username = sub.username || sub.author || '—';
      var affiliation = sub.affiliation || '';
      var authorLine = affiliation ? (username + ' - ' + affiliation) : username;
      document.getElementById('ar-author-name').textContent = authorLine;
      document.getElementById('ar-author-title').textContent = sub.title || '';
      var initials = (sub.username || sub.author || 'AU').split(/\s+/).map(function(w){ return w.charAt(0); }).join('').toUpperCase().slice(0,2);
      document.getElementById('ar-author-avatar').textContent = initials || 'AU';
    }

    var searchInput = document.getElementById('ar-search-input');
    if (searchInput) searchInput.value = '';
    var filtersBtn = document.getElementById('ar-btn-filters');
    if (filtersBtn) filtersBtn.classList.remove('is-open');
    var sidebar = document.getElementById('ar-filters-sidebar');
    if (sidebar) sidebar.classList.remove('ar-filters-open');

    renderArReviewerCards();
    var overlay = document.getElementById('add-reviewer-overlay');
    if (overlay) overlay.classList.add('ar-open');
  }

  function renderArReviewerCards() {
    var list = document.getElementById('ar-reviewer-list');
    var noResults = document.getElementById('ar-no-results');
    if (!list) return;

    list.querySelectorAll('.ar-reviewer-card').forEach(function(c) { c.remove(); });
    if (noResults) noResults.style.display = 'none';

    var reviewersOnly = (window.__arReviewers || []).filter(function(u) {
      return !u.role || u.role === 'reviewer' || u.role === 'editor';
    });

    if (reviewersOnly.length === 0) {
      if (noResults) noResults.style.display = '';
      document.getElementById('ar-filters-count').textContent = '';
      return;
    }

    reviewersOnly.forEach(function(u) {
      var name = ((u.given_name || '') + ' ' + (u.family_name || '')).trim() || u.username || '';
      var searchable = String(name + ' ' + (u.username || '') + ' ' + (u.email || '')).toLowerCase();
      var statusClass = (u.status === 'Busy') ? 'ar-status-busy' : 'ar-status-available';
      var card = document.createElement('div');
      card.className = 'ar-reviewer-card';
      card.setAttribute('data-name', searchable);
      card.setAttribute('data-username', u.username || '');
      card.innerHTML =
        '<div class="ar-reviewer-main">' +
          '<div class="ar-reviewer-topline">' +
            '<span class="ar-reviewer-name">' + escapeHtml(name) + '</span>' +
            '<span class="ar-reviewer-select-wrap">' +
              '<button type="button" class="ar-select-reviewer-btn" onclick="selectArReviewer(this)">Select Reviewer</button>' +
            '</span>' +
          '</div>' +
          '<div class="ar-reviewer-affiliation">' + escapeHtml(u.affiliation || '—') + '</div>' +
          '<div class="ar-reviewer-stats">' +
            '<div class="ar-stat">' +
              '<span class="ar-stat-label">Review Count</span>' +
              '<span class="ar-stat-value">' + (u.review_count || 0) + '</span>' +
            '</div>' +
            '<div class="ar-stat">' +
              '<span class="ar-stat-label">Last Review</span>' +
              '<span class="ar-stat-value">' + (u.last_review || '—') + '</span>' +
            '</div>' +
            '<div class="ar-stat">' +
              '<span class="ar-stat-label">Status</span>' +
              '<span class="ar-status-badge ' + statusClass + '">' + escapeHtml(u.status || 'Available') + '</span>' +
            '</div>' +
          '</div>' +
        '</div>';
      list.appendChild(card);
    });

    arUpdateFilterCount();
    arFilterReviewers();
  }

  function selectArReviewer(btn) {
    var card = btn.closest('.ar-reviewer-card');
    var username = card.getAttribute('data-username');
    var nameEl = card.querySelector('.ar-reviewer-name');
    var name = nameEl ? nameEl.textContent : username;
    document.getElementById('ar-form-reviewer-name').value = name;
    document.getElementById('assign-reviewer-form').submit();
  }
</script>

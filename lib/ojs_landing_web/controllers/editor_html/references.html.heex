<.submission_workflow_layout submission={@submission} active_section={@active_section}>
  <.publication_section_page section_title="References" submission={@submission}>
    <.pub_field label="References" help={true}>
      <textarea class="pub-textarea">{@submission.references}</textarea>
      <p class="pub-hint">
        Type each reference on a new line so that they can be extracted and recorded separately.
      </p>
    </.pub_field>

    <div class="pub-actions">
      <a href="#" class="pub-save-btn">Save</a>
    </div>
  </.publication_section_page>
</.submission_workflow_layout>

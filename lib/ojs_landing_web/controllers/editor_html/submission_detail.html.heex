<.submission_workflow_layout submission={@submission} active_section={@active_section}>
  <.workflow_page title="Submission" submission={@submission}>
    <:actions>
      <a href="#" class="wf-action-btn">Send to Review</a>
      <a href="#" class="wf-action-btn">Accept and Skip Review</a>
      <a href="#" class="wf-action-btn wf-action-danger">Decline Submission</a>
    </:actions>

    <.workflow_files title="Submission Files" files={@submission.files} />

    <.workflow_discussions
      title="Pre-Review Discussions"
      discussions={@submission.discussions}
      add_label="Add Discussion"
    />
  </.workflow_page>

  <%!-- Right action / participants panel --%>
  <aside class="submission-action-panel">
    <div class="submission-participants">
      <div class="submission-participants-header">
        <h3>Participants</h3>
        <a href="#" class="submission-link-btn">Assign</a>
      </div>

      <ul class="submission-participants-list">
        <%= for participant <- @submission.participants do %>
          <li class="submission-participant">
            <div class="submission-participant-avatar">
              {String.first(participant.name)}
            </div>
            <div class="submission-participant-info">
              <div class="submission-participant-name">{participant.name}</div>
              <div class="submission-participant-role">{participant.role}</div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </aside>
</.submission_workflow_layout>

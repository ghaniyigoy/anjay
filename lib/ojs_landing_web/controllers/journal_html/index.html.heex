<div class="content-wrapper">
  <div class="content-inner">
    <div class="journals-list">
      <%= for {journal, index} <- Enum.with_index(@journals) do %>
        <article class={"journal-card journal-card--accent-#{rem(index, 3) + 1}"}>
          <div class="journal-card-body">
            <h2 class="journal-card-title">
              <a href={"/#{journal.path || String.replace(String.downcase(journal.title), " ", "_")}"}>
                {journal.title}
              </a>
            </h2>
            <p class="journal-card-description">{journal.description}</p>
            <div class="journal-card-actions">
              <a
                href={"/#{journal.path || String.replace(String.downcase(journal.title), " ", "_")}"}
                class="journal-card-btn"
              >
                Lihat Jurnal Terbitan Terkini
              </a>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</div>

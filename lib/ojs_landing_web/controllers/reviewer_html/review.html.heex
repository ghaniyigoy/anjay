<div class="review-page">
  <div class="review-breadcrumb">
    <a href="/dashboard/reviewAssignments">My Assignments</a>
    <span class="review-breadcrumb-sep">/</span> <span>Review #{@assignment.id}</span>
  </div>

  <div class="review-page-header">
    <div>
      <h1 class="review-page-title">
        {if @assignment.status in [:action_required, :in_progress],
          do: "Review: " <> truncate_title(@assignment.title),
          else: "Submission Review"}
      </h1>

      <p class="review-page-subtitle">
        Round {@assignment.round} · Due {format_date(@assignment.due_date)}
      </p>
    </div>

    <span class={[
      "review-status-pill",
      if(@assignment.status == :published,
        do: "published",
        else: if(@assignment.status == :completed, do: "done")
      )
    ]}>{status_label(@assignment.status)}</span>
  </div>

  <ol class="rr-stepper">
    <%= for {num, label} <- [
      {1, "Request"},
      {2, "Guidelines"},
      {3, "Download & Review"},
      {4, "Completion"}
    ] do %>
      <li class={["rr-step", wizard_step_class(@assignment, num)]}>
        <span class="rr-step-num">{num}</span> <span class="rr-step-label">{label}</span>
      </li>
    <% end %>
  </ol>

  <div class="review-layout">
    <div class="review-main-col">
      <%= cond do %>
        <% @assignment.status == :action_required or (@assignment.status == :in_progress and @assignment.wizard_step == 1) -> %>
          <div class="rr-container">
            <section class="rr-section">
              <h2 class="rr-section-title">Request for Review</h2>

              <p class="rr-body">
                You have been selected as a potential reviewer of the following submission. Below
                is a summary of the submission. If you decide to review, your review comments will
                be sent back to the editor and made available to the author. The editor has asked
                you to review this submission.
              </p>

              <dl class="rr-meta-list">
                <div class="rr-meta-item">
                  <dt>Article Title</dt>

                  <dd>{@assignment.title}</dd>
                </div>

                <div class="rr-meta-item">
                  <dt>Abstract</dt>

                  <dd>{@assignment.abstract}</dd>
                </div>

                <div class="rr-meta-item">
                  <dt>Review Type</dt>

                  <dd>Round {to_string(@assignment.round)}</dd>
                </div>
              </dl>
            </section>

            <section class="rr-section">
              <div class="rr-files-header">
                <h2 class="rr-files-title">Review Files</h2>

                <div class="rr-files-search">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <circle cx="11" cy="11" r="8"></circle>

                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  Search
                </div>
              </div>

              <table class="rr-files-table">
                <thead>
                  <tr>
                    <th class="rr-files-col-name">
                      <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                        </path>

                        <polyline points="14 2 14 8 20 8"></polyline>
                      </svg>
                      Files
                    </th>

                    <th class="rr-files-col-date">Date</th>

                    <th class="rr-files-col-type">Type</th>
                  </tr>
                </thead>

                <tbody>
                  <%= for file <- @assignment.files do %>
                    <tr class="rr-file-row">
                      <td class="rr-files-col-name">
                        <a href="#" class="rr-file-link">{file_name(file)}</a>
                      </td>

                      <td class="rr-files-col-date">{file.date}</td>

                      <td class="rr-files-col-type">
                        <span class={["rr-file-type", file_type_class(file_type(file))]}>
                          {file_type(file)}
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
              <a href="#" class="rr-view-all">View All Submission Details</a>
            </section>

            <section class="rr-section">
              <h2 class="rr-section-title">Review Schedule</h2>

              <div class="rr-schedule-grid">
                <div class="rr-schedule-item">
                  <span class="rr-schedule-label">Editor's Request</span>
                  <span class="rr-schedule-value">
                    {format_date(@assignment.date_assigned)}
                  </span>
                </div>

                <div class="rr-schedule-item">
                  <span class="rr-schedule-label">Response Due Date</span>
                  <span class="rr-schedule-value">
                    {format_date(@assignment.due_date)}
                  </span>
                </div>

                <div class="rr-schedule-item">
                  <span class="rr-schedule-label">Review Due Date</span>
                  <span class="rr-schedule-value">
                    {format_date(@assignment.due_date)}
                  </span>
                </div>
              </div>

              <div class="rr-about-due">
                <a href="#" class="rr-due-link">About Due Dates</a>
              </div>

              <div class="rr-consent">
                <label class="rr-consent-label">
                  <input type="checkbox" class="rr-consent-checkbox" />
                  <span class="rr-consent-text">
                    Yes, I agree to have my data collected and stored according to the
                    privacy statement.
                  </span>
                </label>
              </div>

              <div class="rr-actions">
                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/decline"}
                  id="decline-review-request"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <button type="submit" class="btn-ojs-secondary" id="btn-decline-review">
                    Decline Review Request
                  </button>
                </form>

                <%= if @assignment.status == :in_progress do %>
                  <form
                    method="POST"
                    action={"/review/#{@assignment.id}/step"}
                    id="continue-review-request"
                  >
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    />
                    <button
                      type="submit"
                      class="btn-ojs-primary"
                      id="btn-continue-to-guidelines"
                    >
                      Continue to Step #2
                    </button>
                  </form>
                <% else %>
                  <form
                    method="POST"
                    action={"/review/#{@assignment.id}/accept"}
                    id="accept-review-request"
                  >
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    />
                    <button type="submit" class="btn-ojs-primary" id="btn-accept-review">
                      Accept Review, Continue to Step #2
                    </button>
                  </form>
                <% end %>
              </div>
            </section>
          </div>
        <% @assignment.status == :in_progress and @assignment.wizard_step in [2, 3] -> %>
          <%= if @assignment.wizard_step == 2 do %>
            <div class="rr-container">
              <section class="rr-section">
                <h2 class="rr-section-title">Review Guidelines</h2>

                <p class="rr-body">
                  Please read the review guidelines below before proceeding with your review.
                  Your comments should be constructive, specific, and respectful. Focus on the
                  substance of the manuscript and help the author improve their work.
                </p>

                <ul class="rr-guideline-list">
                  <li>Evaluate the originality and contribution of the research.</li>

                  <li>Assess the soundness of the methodology and analysis.</li>

                  <li>Provide clear, specific, and actionable feedback.</li>

                  <li>Keep your comments professional and constructive.</li>

                  <li>Do not share the manuscript or its contents.</li>
                </ul>

                <div class="rr-consent">
                  <label class="rr-consent-label">
                    <input type="checkbox" class="rr-consent-checkbox" id="guidelines-consent" />
                    <span class="rr-consent-text">
                      I have read and agree to follow the review guidelines.
                    </span>
                  </label>
                </div>
              </section>

              <div class="rr-actions">
                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/go-back"}
                  id="go-back-guidelines"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <button type="submit" class="btn-ojs-secondary" id="btn-go-back-guidelines">
                    Go Back
                  </button>
                </form>

                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/step"}
                  id="continue-guidelines"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <button type="submit" class="btn-ojs-primary" id="btn-continue-guidelines">
                    Continue to Step #3
                  </button>
                </form>
              </div>
            </div>
          <% else %>
            <div class="rp-container">
              <%!-- Review Files Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>

                      <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    Review Files
                  </h2>

                  <button type="button" class="rp-btn-search" id="btn-search-review-files">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="11" cy="11" r="8"></circle>

                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    Search
                  </button>
                </div>

                <div class="rp-search-bar" id="search-review-files-bar" style="display:none">
                  <input
                    type="text"
                    id="search-review-files-input"
                    class="rp-search-input"
                    placeholder="Search files by name or type…"
                    data-target-table="review-files-table"
                  />
                </div>

                <div class="rp-panel-body">
                  <table class="rp-files-table" id="review-files-table">
                    <thead>
                      <tr>
                        <th>File</th>

                        <th>Date</th>

                        <th>Type</th>
                      </tr>
                    </thead>

                    <tbody>
                      <%= for file <- @assignment.files do %>
                        <tr
                          data-name={String.downcase(file_name(file))}
                          data-type={String.downcase(file_type(file))}
                        >
                          <td><a href="#" class="rp-file-link">{file_name(file)}</a></td>

                          <td class="rp-file-date">{file.date}</td>

                          <td>
                            <span class={["rp-file-badge", file_type_class(file_type(file))]}>
                              {file_type(file)}
                            </span>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
              <%!-- Review Form Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">Review</h2>
                </div>

                <div class="rp-panel-body">
                  <p class="rp-help-text">
                    Enter (or paste) your review of this submission into the form below.
                  </p>

                  <form method="POST" action={"/review/#{@assignment.id}/step"} id="review-form">
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    /> <%!-- For Author and Editor --%>
                    <div class="rp-field">
                      <label class="rp-label">For Author and Editor</label>
                      <div class="rp-richtext-wrapper">
                        <div id="rp-comments-author-toolbar" class="rp-toolbar">
                          <button
                            type="button"
                            data-cmd="bold"
                            class="rp-toolbar-btn"
                            title="Bold"
                          ><b>B</b></button>
                          <button
                            type="button"
                            data-cmd="italic"
                            class="rp-toolbar-btn"
                            title="Italic"
                          ><i>I</i></button>
                          <button
                            type="button"
                            data-cmd="underline"
                            class="rp-toolbar-btn"
                            title="Underline"
                          ><u>U</u></button>
                          <button
                            type="button"
                            data-cmd="insertUnorderedList"
                            class="rp-toolbar-btn"
                            title="Bullet List"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                            >
                              <line x1="8" y1="6" x2="21" y2="6"></line>

                              <line x1="8" y1="12" x2="21" y2="12"></line>

                              <line x1="8" y1="18" x2="21" y2="18"></line>

                              <line x1="3" y1="6" x2="3.01" y2="6"></line>

                              <line x1="3" y1="12" x2="3.01" y2="12"></line>

                              <line x1="3" y1="18" x2="3.01" y2="18"></line>
                            </svg>
                          </button>
                        </div>

                        <input
                          type="hidden"
                          name="comments_author"
                          id="rp-comments-author"
                          value=""
                        /> <div
                          id="rp-comments-author-editor"
                          class="rp-richtext"
                          data-target="rp-comments-author"
                          data-autosave={"review-draft-" <> Integer.to_string(@assignment.id) <> "-author"}
                          contenteditable="true"
                        ></div>
                      </div>
                    </div>
                    <%!-- For Editor --%>
                    <div class="rp-field">
                      <label class="rp-label">For Editor</label>
                      <div class="rp-richtext-wrapper">
                        <div id="rp-comments-editor-toolbar" class="rp-toolbar">
                          <button
                            type="button"
                            data-cmd="bold"
                            class="rp-toolbar-btn"
                            title="Bold"
                          ><b>B</b></button>
                          <button
                            type="button"
                            data-cmd="italic"
                            class="rp-toolbar-btn"
                            title="Italic"
                          ><i>I</i></button>
                          <button
                            type="button"
                            data-cmd="underline"
                            class="rp-toolbar-btn"
                            title="Underline"
                          ><u>U</u></button>
                          <button
                            type="button"
                            data-cmd="insertUnorderedList"
                            class="rp-toolbar-btn"
                            title="Bullet List"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                            >
                              <line x1="8" y1="6" x2="21" y2="6"></line>

                              <line x1="8" y1="12" x2="21" y2="12"></line>

                              <line x1="8" y1="18" x2="21" y2="18"></line>

                              <line x1="3" y1="6" x2="3.01" y2="6"></line>

                              <line x1="3" y1="12" x2="3.01" y2="12"></line>

                              <line x1="3" y1="18" x2="3.01" y2="18"></line>
                            </svg>
                          </button>
                        </div>

                        <input
                          type="hidden"
                          name="comments_editor"
                          id="rp-comments-editor"
                          value=""
                        /> <div
                          id="rp-comments-editor-editor"
                          class="rp-richtext"
                          data-target="rp-comments-editor"
                          data-autosave={"review-draft-" <> Integer.to_string(@assignment.id) <> "-editor"}
                          contenteditable="true"
                        ></div>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
              <%!-- Upload Section --%>
              <div class="rp-panel rp-panel-plain">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">Upload</h2>
                </div>

                <div class="rp-panel-body">
                  <p class="rp-help-text">
                    Upload any files you wish to share with the author or editor. Files you
                    upload will appear in the Reviewer Files panel below.
                  </p>
                </div>
              </div>
              <%!-- Reviewer Files Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">Reviewer Files</h2>

                  <div class="rp-header-actions">
                    <button
                      type="button"
                      class="rp-btn-sm rp-btn-secondary"
                      id="btn-search-reviewer-files"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <circle cx="11" cy="11" r="8"></circle>

                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      </svg>
                      Search
                    </button>

                    <button
                      type="button"
                      class="rp-btn-sm rp-btn-primary"
                      id="btn-upload-reviewer-file"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>

                        <polyline points="17 8 12 3 7 8"></polyline>

                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                      Upload File
                    </button>
                  </div>
                </div>

                <div class="rp-search-bar" id="search-reviewer-files-bar" style="display:none">
                  <input
                    type="text"
                    id="search-reviewer-files-input"
                    class="rp-search-input"
                    placeholder="Search reviewer files…"
                    data-target-table="reviewer-files-table"
                  />
                </div>

                <div class="rp-panel-body rp-file-list" id="reviewer-files-list">
                  <%= if reviewer_files(@assignment.reviewer_files) == [] do %>
                    <div class="rp-empty-state" id="reviewer-files-empty">
                      <p>No reviewer files uploaded yet.</p>
                    </div>
                  <% else %>
                    <table class="rp-files-table rp-files-table-sm" id="reviewer-files-table">
                      <thead>
                        <tr>
                          <th>File</th>

                          <th>Date</th>

                          <th>Type</th>
                        </tr>
                      </thead>

                      <tbody>
                        <%= for file <- reviewer_files(@assignment.reviewer_files) do %>
                          <tr
                            data-name={String.downcase(file_name(file))}
                            data-type={String.downcase(file_type(file))}
                          >
                            <td>
                              <a href="#" class="rp-file-link">{file_name(file)}</a>
                              <div class="rp-file-meta">{file.size}</div>
                            </td>

                            <td class="rp-file-date">{file.date}</td>

                            <td>
                              <span class={["rp-file-badge", file_type_class(file_type(file))]}>
                                {file_type(file)}
                              </span>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  <% end %>
                </div>
              </div>
              <%!-- Review Discussions Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">
                    Review Discussions
                    <span class="rp-badge-count" id="discussion-count">
                      {length(discussions(@assignment.discussions))}
                    </span>
                  </h2>

                  <button type="button" class="rp-btn-sm rp-btn-primary" id="btn-add-discussion">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <line x1="12" y1="5" x2="12" y2="19"></line>

                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add Discussion
                  </button>
                </div>

                <div class="rp-panel-body">
                  <table
                    class="rp-files-table review-discussions-table"
                    id="step3-discussions-table"
                  >
                    <thead>
                      <tr>
                        <th>Name</th>

                        <th>From</th>

                        <th>Last Reply</th>

                        <th>Replies</th>

                        <th>Closed</th>
                      </tr>
                    </thead>

                    <tbody>
                      <%= if discussions(@assignment.discussions) == [] do %>
                        <tr>
                          <td colspan="5" class="rp-empty-state-cell">
                            No discussions yet.
                          </td>
                        </tr>
                      <% else %>
                        <%= for d <- discussions(@assignment.discussions) do %>
                          <tr>
                            <td><a href="#" class="rp-file-link">{d.subject}</a></td>

                            <td>{d.author}</td>

                            <td class="rp-file-date">{last_reply_date(d)}</td>

                            <td>{length(d.replies || [])}</td>

                            <td>
                              <span class="review-discussion-closed-state">
                                <input type="checkbox" class="review-discussion-closed" disabled />
                              </span>
                            </td>
                          </tr>
                        <% end %>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
              <%!-- Upload File Slide-in Drawer --%>
              <div id="upload-reviewer-file-overlay" class="urf-overlay">
                <div class="urf-modal rup-modal">
                  <div class="urf-header">
                    <button
                      type="button"
                      class="urf-back"
                      onclick="closeUploadFileModal()"
                      aria-label="Close"
                    >
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <polyline points="15 18 9 12 15 6"></polyline>
                      </svg>
                    </button>

                    <h2 class="urf-title">Upload File</h2>
                    <span class="urf-title-spacer"></span>
                  </div>

                  <div class="urf-stepper">
                    <div
                      class="urf-step urf-step-active urf-step-clickable"
                      id="rup-step-1-indicator"
                      onclick="rupGoToStep(1)"
                    >
                      <span class="urf-step-num">1</span>
                      <span class="urf-step-label">Upload File</span>
                    </div>

                    <div class="urf-step-connector"></div>

                    <div class="urf-step" id="rup-step-2-indicator" onclick="rupGoToStep(2)">
                      <span class="urf-step-num">2</span>
                      <span class="urf-step-label">Review Details</span>
                    </div>

                    <div class="urf-step-connector"></div>

                    <div class="urf-step" id="rup-step-3-indicator" onclick="rupGoToStep(3)">
                      <span class="urf-step-num">3</span>
                      <span class="urf-step-label">Confirm</span>
                    </div>
                  </div>

                  <form
                    method="POST"
                    action={"/review/#{@assignment.id}/file"}
                    enctype="multipart/form-data"
                    id="rup-upload-form"
                  >
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    />
                    <div class="urf-body">
                      <%!-- Step 1: Upload File --%>
                      <div class="urf-step-content" id="rup-step-1">
                        <input
                          type="file"
                          name="upload"
                          id="rup-file-input"
                          class="rup-file-input-hidden"
                          onchange="rupOnFileSelected(this)"
                        />
                        <div class="rup-upload-layout">
                          <div class="rup-selected-item" id="rup-dropzone">
                            <div class="rup-selected-icon">
                              <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                              >
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                </path>

                                <polyline points="14 2 14 8 20 8"></polyline>
                              </svg>
                            </div>

                            <div class="rup-selected-info">
                              <span class="rup-selected-name" id="rup-selected-name">
                                No file selected
                              </span>

                              <span class="rup-selected-meta" id="rup-selected-meta">
                                Drag &amp; drop a file here, or click to browse
                              </span>
                            </div>

                            <button
                              type="button"
                              class="rup-selected-remove"
                              id="rup-selected-remove"
                              onclick="rupRemoveFile(event)"
                              title="Remove file"
                            >
                              <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                              >
                                <polyline points="3 6 5 6 21 6"></polyline>

                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                </path>
                              </svg>
                            </button>
                          </div>

                          <div class="rup-upload-side">
                            <button
                              type="button"
                              class="urf-btn-upload"
                              id="rup-btn-upload"
                              onclick="document.getElementById('rup-file-input').click()"
                            >
                              <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                              >
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>

                                <polyline points="17 8 12 3 7 8"></polyline>

                                <line x1="12" y1="3" x2="12" y2="15"></line>
                              </svg>
                              <span id="rup-btn-upload-label">Upload File</span>
                            </button>
                          </div>
                        </div>
                      </div>
                      <%!-- Step 2: Review Details --%>
                      <div class="urf-step-content urf-step-hidden" id="rup-step-2">
                        <p class="urf-hint">Review the file details before confirming.</p>

                        <div class="urf-detail-row">
                          <span class="urf-detail-label">File Name:</span>
                          <span class="urf-detail-value" id="rup-detail-filename">—</span>
                        </div>

                        <div class="urf-detail-row">
                          <span class="urf-detail-label">File Size:</span>
                          <span class="urf-detail-value" id="rup-detail-filesize">—</span>
                        </div>
                      </div>
                      <%!-- Step 3: Confirm --%>
                      <div class="urf-step-content urf-step-hidden" id="rup-step-3">
                        <div class="urf-confirm-box">
                          <p class="urf-confirm-text">File Added</p>

                          <p class="rup-confirm-sub">
                            Ready to upload “<span id="rup-confirm-filename">—</span>”.
                          </p>
                        </div>
                      </div>
                    </div>

                    <div class="urf-footer rup-footer">
                      <button
                        type="button"
                        class="urf-btn-cancel"
                        onclick="closeUploadFileModal()"
                      >
                        Cancel
                      </button>

                      <button
                        type="button"
                        class="urf-btn-continue"
                        id="rup-btn-continue"
                        disabled
                        onclick="rupNextStep()"
                      >Continue</button>
                    </div>
                  </form>
                </div>
              </div>
              <%!-- Actions for Step 3: Continue to Step 4 (Recommendation moved to Step 4 per OJS 4-step spec) --%>
              <div class="rp-panel">
                <div class="rp-panel-footer">
                  <div class="rp-actions">
                    <form
                      method="POST"
                      action={"/review/#{@assignment.id}/go-back"}
                      id="rp-go-back-form"
                    >
                      <input
                        type="hidden"
                        name="_csrf_token"
                        value={Plug.CSRFProtection.get_csrf_token()}
                      />
                      <button type="submit" class="rp-btn rp-btn-secondary" id="rp-btn-go-back">
                        Go back
                      </button>
                    </form>

                    <div class="rp-actions-right">
                      <button type="button" class="rp-btn rp-btn-secondary" id="rp-btn-save-later">
                        Save For Later
                      </button>

                      <button
                        type="submit"
                        form="review-form"
                        class="rp-btn rp-btn-primary"
                        id="rp-btn-submit-review"
                      >
                        Continue to Step 4
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% @assignment.status == :in_progress and @assignment.wizard_step == 4 -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>

                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              Completion
            </h2>

            <div class="review-submitted-summary">
              <p class="review-help">
                You have finished reviewing this submission. Select your final recommendation
                below and submit your review to the editor. You can still go back to review the
                manuscript or edit your comments at any time.
              </p>

              <%= if @assignment.comments_author not in [nil, ""] or @assignment.comments_editor not in [nil, ""] do %>
                <dl class="review-meta-list">
                  <%= if @assignment.comments_author not in [nil, ""] do %>
                    <div class="review-meta-item">
                      <dt>Comments to the Author</dt>

                      <dd>{@assignment.comments_author}</dd>
                    </div>
                  <% end %>

                  <%= if @assignment.comments_editor not in [nil, ""] do %>
                    <div class="review-meta-item">
                      <dt>Comments to the Editor</dt>

                      <dd>{@assignment.comments_editor}</dd>
                    </div>
                  <% end %>
                </dl>
              <% end %>

              <form method="POST" action={"/review/#{@assignment.id}"} id="completion-submit">
                <input
                  type="hidden"
                  name="_csrf_token"
                  value={Plug.CSRFProtection.get_csrf_token()}
                />
                <input
                  type="hidden"
                  name="comments_author"
                  value={@assignment.comments_author || ""}
                />
                <input
                  type="hidden"
                  name="comments_editor"
                  value={@assignment.comments_editor || ""}
                />
                <div class="review-field">
                  <span class="review-label">Recommendation <span class="review-req">*</span></span>
                  <p class="review-help">
                    Select the overall recommendation for this submission.
                  </p>

                  <div class="review-recommendation-options">
                    <label class="review-radio" id="rec-accept">
                      <input
                        type="radio"
                        name="recommendation"
                        value="Accept"
                        required
                        checked={@assignment.recommendation == "Accept"}
                      /> <span>Accept Submission</span>
                    </label>

                    <label class="review-radio" id="rec-revisions">
                      <input
                        type="radio"
                        name="recommendation"
                        value="Revisions Required"
                        required
                        checked={@assignment.recommendation == "Revisions Required"}
                      /> <span>Revisions Required</span>
                    </label>

                    <label class="review-radio" id="rec-resubmit">
                      <input
                        type="radio"
                        name="recommendation"
                        value="Resubmit for Review"
                        required
                        checked={@assignment.recommendation == "Resubmit for Review"}
                      /> <span>Resubmit for Review</span>
                    </label>

                    <label class="review-radio" id="rec-decline">
                      <input
                        type="radio"
                        name="recommendation"
                        value="Decline Submission"
                        required
                        checked={@assignment.recommendation == "Decline Submission"}
                      /> <span>Decline Submission</span>
                    </label>
                  </div>

                  <p class="review-help" style="margin-top: 8px; font-size: 12px;">
                    OJS alternatives: Resubmit Elsewhere / See Comments are also accepted if needed.
                  </p>
                </div>
              </form>

              <div class="review-form-actions">
                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/go-back"}
                  id="completion-go-back"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <button type="submit" class="btn-ojs-secondary" id="btn-completion-go-back">
                    Go Back to Review
                  </button>
                </form>

                <button
                  type="submit"
                  form="completion-submit"
                  class="btn-ojs-primary"
                  id="btn-completion-submit-review"
                >
                  Submit Review
                </button>
              </div>
            </div>

            <div class="review-discussions-panel">
              <div class="review-discussions-header">
                <h3>Review Discussions</h3>

                <button type="button" class="rp-btn-sm rp-btn-primary" id="btn-add-discussion">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>

                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  Add discussion
                </button>
              </div>

              <div class="review-discussions-list">
                <table class="rp-files-table review-discussions-table">
                  <thead>
                    <tr>
                      <th>Name</th>

                      <th>From</th>

                      <th>Last Reply</th>

                      <th>Replies</th>

                      <th>Closed</th>
                    </tr>
                  </thead>

                  <tbody>
                    <%= if discussions(@assignment.discussions) == [] do %>
                      <tr>
                        <td colspan="5" class="rp-empty-state-cell">
                          No discussions have been started yet.
                        </td>
                      </tr>
                    <% else %>
                      <%= for d <- discussions(@assignment.discussions) do %>
                        <tr>
                          <td><a href="#" class="rp-file-link">{d.subject}</a></td>

                          <td>{d.author}</td>

                          <td class="rp-file-date">{last_reply_date(d)}</td>

                          <td>{length(d.replies || [])}</td>

                          <td>
                            <span class="review-discussion-closed-state">
                              <input type="checkbox" class="review-discussion-closed" disabled />
                            </span>
                          </td>
                        </tr>
                      <% end %>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% @assignment.status == :declined -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>

                <line x1="15" y1="9" x2="9" y2="15"></line>

                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
              Review Declined
            </h2>

            <div class="review-submitted-summary">
              <p class="review-help">
                You have declined this review assignment. The editor will find another reviewer
                for this submission.
              </p>

              <div class="review-form-actions">
                <a href="/dashboard/reviewAssignments" class="btn-ojs-primary">
                  Back to My Assignments
                </a>
              </div>
            </div>
          </div>
        <% @assignment.status == :published -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>

                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              Published
            </h2>

            <div class="review-submitted-summary">
              <p class="review-help">This submission has been published to the journal.</p>

              <dl class="review-meta-list">
                <div class="review-meta-item">
                  <dt>Issue</dt>

                  <dd>{@assignment.issue || "Current Issue"}</dd>
                </div>

                <div class="review-meta-item">
                  <dt>Published</dt>

                  <dd>
                    <%= if @assignment.published_at do %>
                      {@assignment.published_at |> DateTime.to_date() |> Date.to_string()}
                    <% else %>
                      —
                    <% end %>
                  </dd>
                </div>

                <div class="review-meta-item">
                  <dt>Galley Files</dt>

                  <dd>{length(@assignment.galley_files)}</dd>
                </div>
              </dl>

              <div class="review-form-actions">
                <a href="/dashboard/reviewAssignments" class="btn-ojs-primary">
                  Back to My Assignments
                </a>
              </div>
            </div>
          </div>
        <% @assignment.status == :completed -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>

                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              Review Submitted
            </h2>

            <div class="review-submitted-summary">
              <p class="review-help">
                Your review for this submission has been recorded and the workflow has moved to the
                next stage. Thank you for your contribution.
              </p>

              <dl class="review-meta-list">
                <div class="review-meta-item">
                  <dt>Recommendation</dt>

                  <dd>{@assignment.recommendation || "None"}</dd>
                </div>

                <%= if @assignment.comments_author do %>
                  <div class="review-meta-item">
                    <dt>Comments to the Author</dt>

                    <dd>{@assignment.comments_author}</dd>
                  </div>
                <% end %>

                <%= if @assignment.comments_editor do %>
                  <div class="review-meta-item">
                    <dt>Comments to the Editor</dt>

                    <dd>{@assignment.comments_editor}</dd>
                  </div>
                <% end %>
              </dl>

              <div class="review-form-actions">
                <a href="/dashboard/reviewAssignments" class="btn-ojs-secondary">
                  Back to My Assignments
                </a>
              </div>
            </div>
          </div>
        <% true -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>

                <polyline points="7 10 12 15 17 10"></polyline>

                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Review Submission
            </h2>

            <form method="POST" action={"/review/#{@assignment.id}"}>
              <input
                type="hidden"
                name="_csrf_token"
                value={Plug.CSRFProtection.get_csrf_token()}
              />
              <div class="review-field">
                <label class="review-label" for="recommendation">
                  Recommendation <span class="review-req">*</span>
                </label>

                <p class="review-help">Select the overall recommendation for this submission.</p>

                <select id="recommendation" name="recommendation" class="review-select" required>
                  <option value="" disabled selected>Select a recommendation…</option>

                  <option value="Accept">Accept</option>

                  <option value="Minor Revisions">Minor Revisions</option>

                  <option value="Major Revisions">Major Revisions</option>

                  <option value="Resubmit Elsewhere">Resubmit Elsewhere</option>

                  <option value="Decline">Decline</option>
                </select>
              </div>

              <div class="review-field">
                <span class="review-label">Quality Criteria</span>
                <p class="review-help">Assess each criterion below.</p>

                <div class="review-criteria">
                  <%= for {criterion, index} <- Enum.with_index(@criteria) do %>
                    <div class="review-criterion">
                      <div class="review-criterion-text">
                        <span class="review-criterion-label">
                          {index + 1}. {criterion.label}
                        </span>
                        <span class="review-criterion-question">{criterion.question}</span>
                      </div>

                      <div class="review-criterion-options">
                        <label class="review-radio">
                          <input
                            type="radio"
                            name={"criterion_#{index}"}
                            value="Yes"
                            checked={index == 0}
                          /> <span>Yes</span>
                        </label>

                        <label class="review-radio">
                          <input type="radio" name={"criterion_#{index}"} value="No" />
                          <span>No</span>
                        </label>

                        <label class="review-radio">
                          <input type="radio" name={"criterion_#{index}"} value="Maybe" />
                          <span>Maybe</span>
                        </label>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="review-field">
                <label class="review-label" for="comments_author">Comments to the Author</label>
                <p class="review-help">
                  This review will be shared with the author. Be specific and constructive.
                </p>
                <textarea
                  id="comments_author"
                  name="comments_author"
                  rows="7"
                  class="review-textarea"
                  placeholder="Summarize the main strengths and weaknesses of the manuscript…"
                ></textarea>
              </div>

              <div class="review-field">
                <label class="review-label" for="comments_editor">Comments to the Editor</label>
                <p class="review-help">
                  Private comments that will only be visible to the editor.
                </p>
                <textarea
                  id="comments_editor"
                  name="comments_editor"
                  rows="4"
                  class="review-textarea"
                  placeholder="Confidential feedback for the editor…"
                ></textarea>
              </div>

              <div class="review-form-actions">
                <button type="submit" class="btn-ojs-primary">Submit Review</button>
                <a href="/dashboard/reviewAssignments" class="btn-ojs-secondary">Cancel</a>
              </div>
            </form>
          </div>
      <% end %>
    </div>
  </div>
  <%!-- Add Discussion Slide-in Drawer --%>
  <div id="review-discussion-overlay" class="prd-overlay">
    <div class="prd-panel">
      <div class="prd-header">
        <button
          type="button"
          class="prd-back"
          onclick="closeReviewDiscussionModal()"
          aria-label="Back"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <h2 class="prd-title">Add Discussion</h2>
      </div>

      <form
        method="POST"
        action={"/review/#{@assignment.id}/discussion"}
        id="review-discussion-form"
      >
        <input
          type="hidden"
          name="_csrf_token"
          value={Plug.CSRFProtection.get_csrf_token()}
        />
        <div class="prd-body">
          <section class="prd-section">
            <h3 class="prd-label">Participants</h3>

            <%= for {participant, idx} <- Enum.with_index(review_participants(@assignment, @user)) do %>
              <label class="prd-checkbox-row">
                <input
                  type="checkbox"
                  name="participant[]"
                  id={"review-discussion-participant-#{idx + 1}"}
                  value={participant.name}
                  checked
                /> <span class="prd-checkbox-name">{participant.name}</span>
                <span class="prd-role">{participant.role}</span>
              </label>
            <% end %>
          </section>
          <label class="prd-label" for="review-discussion-subject">Subject</label>
          <input
            type="text"
            name="subject"
            id="review-discussion-subject"
            class="prd-input"
            placeholder="Brief subject line"
            required
          /> <label class="prd-label">Message</label>
          <div class="prd-richtext-wrapper">
            <div id="review-discussion-message-toolbar" class="prd-toolbar">
              <button type="button" data-cmd="bold" class="prd-toolbar-btn" title="Bold">
                <b>B</b>
              </button>

              <button type="button" data-cmd="italic" class="prd-toolbar-btn" title="Italic">
                <i>I</i>
              </button>

              <button type="button" data-cmd="underline" class="prd-toolbar-btn" title="Underline">
                <u>U</u>
              </button>

              <button
                type="button"
                data-cmd="insertUnorderedList"
                class="prd-toolbar-btn"
                title="Bullet List"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <line x1="8" y1="6" x2="21" y2="6"></line>

                  <line x1="8" y1="12" x2="21" y2="12"></line>

                  <line x1="8" y1="18" x2="21" y2="18"></line>

                  <line x1="3" y1="6" x2="3.01" y2="6"></line>

                  <line x1="3" y1="12" x2="3.01" y2="12"></line>

                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
              </button>
            </div>

            <input
              type="hidden"
              name="message"
              id="review-discussion-message"
              value=""
              required
            /> <div
              id="review-discussion-message-editor"
              class="prd-richtext"
              data-target="review-discussion-message"
              data-placeholder="Write your message…"
              contenteditable="true"
            ></div>
          </div>

          <div class="prd-form-error" id="review-discussion-error" style="display:none">
            A message is required to start the discussion.
          </div>
          
          <div class="prd-attach-box">
            <div class="prd-attach-head">
              <h3 class="prd-attach-title">Attached Files</h3>

              <div class="prd-attach-actions">
                <button type="button" id="rd-btn-search-file" class="prd-btn-outline">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <circle cx="11" cy="11" r="8"></circle>

                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  Search
                </button>

                <button
                  type="button"
                  id="rd-btn-upload-file"
                  class="prd-btn-outline"
                  onclick="openReviewDiscussionUploadModal()"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    
                    <polyline points="17 8 12 3 7 8"></polyline>
                    
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                  </svg>
                  Upload File
                </button>
              </div>
            </div>
            
            <div
              class="rd-attach-search"
              id="rd-attach-search-bar"
              style="display:none"
            >
              <input
                type="text"
                id="rd-attach-search-input"
                class="rd-attach-search-input"
                placeholder="Search attached files…"
              />
            </div>

            <div class="prd-attach-body" id="rd-attach-body">
              <div class="prd-attach-empty">No files are attached to this discussion.</div>
            </div>
          </div>

          <input
            type="hidden"
            name="attached_files"
            id="rd-attached-files"
            value=""
          />
        </div>

        <div class="prd-footer">
          <button
            type="button"
            class="prd-btn-secondary"
            onclick="closeReviewDiscussionModal()"
          >
            Cancel
          </button>
          <button type="submit" class="prd-btn-primary">OK</button>
        </div>
      </form>
    </div>
  </div>
   <%!-- Upload Discussion File Slide-in Drawer --%>
  <div id="review-discussion-upload-overlay" class="urf-overlay rdud-overlay">
    <div class="urf-modal rup-modal">
      <div class="urf-header">
        <button
          type="button"
          class="urf-back"
          onclick="closeReviewDiscussionUploadModal()"
          aria-label="Close"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        
        <h2 class="urf-title">Upload a Discussion File</h2>
         <span class="urf-title-spacer"></span>
      </div>
      
      <div class="urf-stepper">
        <div
          class="urf-step urf-step-active urf-step-clickable"
          id="rdud-step-1-indicator"
          onclick="rdudGoToStep(1)"
        >
          <span class="urf-step-num">1</span> <span class="urf-step-label">Upload File</span>
        </div>
        
        <div class="urf-step-connector"></div>
        
        <div class="urf-step" id="rdud-step-2-indicator" onclick="rdudGoToStep(2)">
          <span class="urf-step-num">2</span> <span class="urf-step-label">Review Details</span>
        </div>
        
        <div class="urf-step-connector"></div>
        
        <div class="urf-step" id="rdud-step-3-indicator" onclick="rdudGoToStep(3)">
          <span class="urf-step-num">3</span> <span class="urf-step-label">Confirm</span>
        </div>
      </div>
      
      <div class="urf-body">
        <%!-- Step 1: Upload File --%>
        <div class="urf-step-content" id="rdud-step-1">
          <div class="urf-field-group">
            <label class="urf-label" for="rdud-component-select">
              <span class="rdud-required">*</span> Article Component
            </label>
            
            <select
              id="rdud-component-select"
              class="urf-select"
              onchange="rdudOnComponentChange(this)"
            >
              <option value="">Select article component</option>
              
              <option>Article Text</option>
              
              <option>Research Instrument</option>
              
              <option>Research Materials</option>
              
              <option>Research Results</option>
              
              <option>Transcript</option>
              
              <option>Data Analysis</option>
              
              <option>Data Set</option>
              
              <option>Source Text</option>
              
              <option>Other</option>
            </select>
          </div>
          
          <div class="rdud-upload-row" id="rdud-upload-row" style="display:none">
            <input
              type="file"
              id="rdud-file-input"
              class="rup-file-input-hidden"
              onchange="rdudOnFileSelected(this)"
            />
            <div class="rup-upload-layout">
              <div class="rup-selected-item" id="rdud-dropzone">
                <div class="rup-selected-icon">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                </div>
                
                <div class="rup-selected-info">
                  <span class="rup-selected-name" id="rdud-selected-name">
                    No file selected
                  </span>
                  
                  <span class="rup-selected-meta" id="rdud-selected-meta">
                    Drag &amp; drop a file here, or click to browse
                  </span>
                </div>
                
                <button
                  type="button"
                  class="rup-selected-remove"
                  id="rdud-selected-remove"
                  onclick="rdudRemoveFile(event)"
                  title="Remove file"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="3 6 5 6 21 6"></polyline>
                    
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                    </path>
                  </svg>
                </button>
              </div>
              
              <div class="rup-upload-side">
                <button
                  type="button"
                  class="urf-btn-upload"
                  id="rdud-btn-upload"
                  onclick="document.getElementById('rdud-file-input').click()"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    
                    <polyline points="17 8 12 3 7 8"></polyline>
                    
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                  </svg>
                   <span id="rdud-btn-upload-label">Upload File</span>
                </button>
              </div>
            </div>
          </div>
        </div>
         <%!-- Step 2: Review Details --%>
        <div class="urf-step-content urf-step-hidden" id="rdud-step-2">
          <p class="urf-hint">Review the file details before confirming.</p>
          
          <div class="urf-detail-row">
            <span class="urf-detail-label">File Name:</span>
            <span class="urf-detail-value" id="rdud-detail-filename">—</span>
          </div>
          
          <div class="urf-detail-row">
            <span class="urf-detail-label">File Size:</span>
            <span class="urf-detail-value" id="rdud-detail-filesize">—</span>
          </div>
          
          <div class="urf-detail-row">
            <span class="urf-detail-label">Article Component:</span>
            <span class="urf-detail-value" id="rdud-detail-component">—</span>
          </div>
        </div>
         <%!-- Step 3: Confirm --%>
        <div class="urf-step-content urf-step-hidden" id="rdud-step-3">
          <div class="urf-confirm-box">
            <p class="urf-confirm-text">File Added</p>
            
            <p class="rup-confirm-sub">
              Ready to add “<span id="rdud-confirm-filename">—</span>” to the discussion.
            </p>
          </div>
        </div>
      </div>
      
      <div class="urf-footer rup-footer">
        <button
          type="button"
          class="urf-btn-cancel"
          onclick="closeReviewDiscussionUploadModal()"
        >
          Cancel
        </button>
        
        <button
          type="button"
          class="urf-btn-continue"
          id="rdud-btn-continue"
          disabled
          onclick="rdudNextStep()"
        >Continue</button>
      </div>
    </div>
  </div>
</div>

<script>
        var rupFile = null;
        var rupStep = 1;

        function rupBytes(bytes) {
          if (!bytes && bytes !== 0) return '';
          if (bytes < 1024) return bytes + ' B';
          if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
          return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

    function rupReset() {
          rupFile = null;
          rupStep = 1;
          var input = document.getElementById('rup-file-input');
          if (input && 'value' in input) input.value = '';
          var item = document.getElementById('rup-dropzone');
          if (item) item.classList.remove('rup-selected-item-active', 'rup-selected-item-has-file');
          var name = document.getElementById('rup-selected-name');
          if (name) name.textContent = 'No file selected';
          var meta = document.getElementById('rup-selected-meta');
          if (meta) meta.textContent = 'Drag & drop a file here, or click to browse';
          var filename = document.getElementById('rup-confirm-filename');
          if (filename) filename.textContent = '—';
          var cont = document.getElementById('rup-btn-continue');
          if (cont) {
            cont.disabled = true;
            cont.textContent = 'Continue';
          }
          var btn = document.getElementById('rup-btn-upload');
          var label = document.getElementById('rup-btn-upload-label');
          if (btn && label) {
            label.textContent = 'Upload File';
            btn.classList.remove('urf-btn-change-file');
            btn.classList.add('urf-btn-upload');
          }
          rupShowStep(1);
        }

        function rupOnFileSelected(input) {
          rupFile = input.files && input.files[0];
          var item = document.getElementById('rup-dropzone');
          if (item) item.classList.toggle('rup-selected-item-has-file', !!rupFile);
          var name = document.getElementById('rup-selected-name');
          var meta = document.getElementById('rup-selected-meta');
          if (rupFile) {
            if (name) name.textContent = rupFile.name;
            if (meta) meta.textContent = rupBytes(rupFile.size) + ' · ready to upload';
          } else {
            if (name) name.textContent = 'No file selected';
            if (meta) meta.textContent = 'Drag & drop a file here, or click to browse';
          }
          var btn = document.getElementById('rup-btn-upload');
          var label = document.getElementById('rup-btn-upload-label');
          if (btn && label) {
            label.textContent = rupFile ? 'Change File' : 'Upload File';
            btn.classList.toggle('urf-btn-change-file', !!rupFile);
            btn.classList.toggle('urf-btn-upload', !rupFile);
          }
          var filename = document.getElementById('rup-confirm-filename');
          if (filename) filename.textContent = rupFile ? rupFile.name : '—';
          var cont = document.getElementById('rup-btn-continue');
          if (cont && rupStep === 1) cont.disabled = !rupFile;
        }

        function rupRemoveFile(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          var input = document.getElementById('rup-file-input');
          if (input) input.value = '';
          rupOnFileSelected(input);
        }

        function rupShowStep(step) {
          rupStep = step;
          for (var i = 1; i <= 3; i++) {
            var content = document.getElementById('rup-step-' + i);
            if (content) content.classList.toggle('urf-step-hidden', i !== step);
            var indicator = document.getElementById('rup-step-' + i + '-indicator');
            if (indicator) {
              indicator.classList.toggle('urf-step-active', i === step);
              indicator.classList.toggle('urf-step-done', i < step);
              indicator.classList.toggle('urf-step-clickable', i <= step);
            }
          }
          var cont = document.getElementById('rup-btn-continue');
          if (cont) {
            if (step === 1) {
              cont.textContent = 'Continue';
              cont.disabled = !rupFile;
            } else if (step === 2) {
              cont.textContent = 'Continue';
              cont.disabled = false;
            } else if (step === 3) {
              cont.textContent = 'Upload';
              cont.disabled = false;
            }
          }
        }

        window.rupGoToStep = function (step) {
          if (step > rupStep) return;
          if (step >= 3 && rupStep < 3) return;
          rupShowStep(step);
        };

        function rupNextStep() {
          if (rupStep === 1) {
            var fn = document.getElementById('rup-detail-filename');
            if (fn) fn.textContent = rupFile ? rupFile.name : '—';
            var fs = document.getElementById('rup-detail-filesize');
            if (fs) fs.textContent = rupFile ? rupBytes(rupFile.size) : '—';
            rupShowStep(2);
          } else if (rupStep === 2) {
            rupShowStep(3);
          } else if (rupStep === 3) {
            var form = document.getElementById('rup-upload-form');
            if (form) form.submit();
          }
        }

        function rupBindDropzone() {
          var dz = document.getElementById('rup-dropzone');
          var input = document.getElementById('rup-file-input');
          if (!dz || !input) return;
          dz.addEventListener('click', function () {
            input.click();
          });
    ['dragenter', 'dragover'].forEach(function (name) {
            dz.addEventListener(name, function (e) {
              e.preventDefault();
              e.stopPropagation();
              dz.classList.add('rup-selected-item-active');
            });
          });
          ['dragleave', 'drop'].forEach(function (name) {
            dz.addEventListener(name, function (e) {
              e.preventDefault();
              e.stopPropagation();
              dz.classList.remove('rup-selected-item-active');
            });
          });
          dz.addEventListener('drop', function (e) {
            var files = e.dataTransfer && e.dataTransfer.files;
            if (files && files.length) {
              try {
                var dt = new DataTransfer();
                dt.items.add(files[0]);
                input.files = dt.files;
              } catch (err) {
                input.files = files;
              }
              rupOnFileSelected(input);
            }
          });
        }

        function openUploadFileModal() {
          var overlay = document.getElementById('upload-reviewer-file-overlay');
          if (overlay) {
            overlay.classList.add('urf-open');
            rupReset();
          }
        }

        function closeUploadFileModal() {
          var overlay = document.getElementById('upload-reviewer-file-overlay');
          if (overlay) {
            overlay.classList.remove('urf-open');
            setTimeout(rupReset, 320);
          }
        }

    var rdAttachedFiles = [];

        function openReviewDiscussionModal() {
          var overlay = document.getElementById('review-discussion-overlay');
          if (overlay) overlay.classList.add('prd-open');
          resetReviewDiscussionForm();
        }

  function closeReviewDiscussionModal() {
          var overlay = document.getElementById('review-discussion-overlay');
          if (overlay) overlay.classList.remove('prd-open');
        }

    var rdudFile = null;
        var rdudStep = 1;

        function rdudBytes(bytes) {
          if (!bytes && bytes !== 0) return '';
          if (bytes < 1024) return bytes + ' B';
          if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
          return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        function rdudReset() {
          rdudFile = null;
          rdudStep = 1;
          var comp = document.getElementById('rdud-component-select');
          if (comp) comp.value = '';
          var row = document.getElementById('rdud-upload-row');
          if (row) row.style.display = 'none';
          var input = document.getElementById('rdud-file-input');
          if (input && 'value' in input) input.value = '';
          var item = document.getElementById('rdud-dropzone');
          if (item) item.classList.remove('rup-selected-item-active', 'rup-selected-item-has-file');
          var name = document.getElementById('rdud-selected-name');
          if (name) name.textContent = 'No file selected';
          var meta = document.getElementById('rdud-selected-meta');
          if (meta) meta.textContent = 'Drag & drop a file here, or click to browse';
          var filename = document.getElementById('rdud-confirm-filename');
          if (filename) filename.textContent = '—';
          var btn = document.getElementById('rdud-btn-upload');
          var label = document.getElementById('rdud-btn-upload-label');
          if (btn && label) {
            label.textContent = 'Upload File';
            btn.classList.remove('urf-btn-change-file');
            btn.classList.add('urf-btn-upload');
          }
          rdudShowStep(1);
        }

        function rdudUpdateContinue() {
          var cont = document.getElementById('rdud-btn-continue');
          if (!cont || rdudStep !== 1) return;
          var comp = document.getElementById('rdud-component-select');
          cont.disabled = !(rdudFile && comp && comp.value);
        }

        function rdudOnComponentChange(sel) {
          var row = document.getElementById('rdud-upload-row');
          if (row) row.style.display = sel && sel.value ? 'block' : 'none';
          rdudUpdateContinue();
        }

        function rdudOnFileSelected(input) {
          rdudFile = input.files && input.files[0];
          var item = document.getElementById('rdud-dropzone');
          if (item) item.classList.toggle('rup-selected-item-has-file', !!rdudFile);
          var name = document.getElementById('rdud-selected-name');
          var meta = document.getElementById('rdud-selected-meta');
          if (rdudFile) {
            if (name) name.textContent = rdudFile.name;
            if (meta) meta.textContent = rdudBytes(rdudFile.size) + ' · ready to upload';
          } else {
            if (name) name.textContent = 'No file selected';
            if (meta) meta.textContent = 'Drag & drop a file here, or click to browse';
          }
          var btn = document.getElementById('rdud-btn-upload');
          var label = document.getElementById('rdud-btn-upload-label');
          if (btn && label) {
            label.textContent = rdudFile ? 'Change File' : 'Upload File';
            btn.classList.toggle('urf-btn-change-file', !!rdudFile);
            btn.classList.toggle('urf-btn-upload', !rdudFile);
          }
          var filename = document.getElementById('rdud-confirm-filename');
          if (filename) filename.textContent = rdudFile ? rdudFile.name : '—';
          rdudUpdateContinue();
        }

        function rdudRemoveFile(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          var input = document.getElementById('rdud-file-input');
          if (input) input.value = '';
          rdudOnFileSelected(input);
        }

        function rdudShowStep(step) {
          rdudStep = step;
          for (var i = 1; i <= 3; i++) {
            var content = document.getElementById('rdud-step-' + i);
            if (content) content.classList.toggle('urf-step-hidden', i !== step);
            var indicator = document.getElementById('rdud-step-' + i + '-indicator');
            if (indicator) {
              indicator.classList.toggle('urf-step-active', i === step);
              indicator.classList.toggle('urf-step-done', i < step);
              indicator.classList.toggle('urf-step-clickable', i <= step);
            }
          }
          var cont = document.getElementById('rdud-btn-continue');
          if (cont) {
            if (step === 1) {
              cont.textContent = 'Continue';
              rdudUpdateContinue();
            } else if (step === 2) {
              cont.textContent = 'Continue';
              cont.disabled = false;
            } else if (step === 3) {
              cont.textContent = 'Upload';
              cont.disabled = false;
            }
          }
        }

        window.rdudGoToStep = function (step) {
          if (step > rdudStep) return;
          if (step >= 3 && rdudStep < 3) return;
          rdudShowStep(step);
        };

        function rdudNextStep() {
          if (rdudStep === 1) {
            var fn = document.getElementById('rdud-detail-filename');
            if (fn) fn.textContent = rdudFile ? rdudFile.name : '—';
            var fs = document.getElementById('rdud-detail-filesize');
            if (fs) fs.textContent = rdudFile ? rdudBytes(rdudFile.size) : '—';
            var dc = document.getElementById('rdud-detail-component');
            if (dc) {
              var comp = document.getElementById('rdud-component-select');
              dc.textContent = comp ? comp.value : '—';
            }
            rdudShowStep(2);
          } else if (rdudStep === 2) {
            rdudShowStep(3);
          } else if (rdudStep === 3) {
            rdudCommitUpload();
          }
        }

        function rdudCommitUpload() {
          if (!rdudFile) return;
          rdAttachedFiles.push({
            id: 'rd-' + Date.now() + '-' + Math.floor(Math.random() * 100000),
            name: rdudFile.name,
            size: rdudBytes(rdudFile.size)
          });
          renderReviewDiscussionAttachments();
          closeReviewDiscussionUploadModal();
        }

        function rdudBindDropzone() {
          var dz = document.getElementById('rdud-dropzone');
          var input = document.getElementById('rdud-file-input');
          if (!dz || !input) return;
          dz.addEventListener('click', function () {
            input.click();
          });
          ['dragenter', 'dragover'].forEach(function (name) {
            dz.addEventListener(name, function (e) {
              e.preventDefault();
              e.stopPropagation();
              dz.classList.add('rup-selected-item-active');
            });
          });
          ['dragleave', 'drop'].forEach(function (name) {
            dz.addEventListener(name, function (e) {
              e.preventDefault();
              e.stopPropagation();
              dz.classList.remove('rup-selected-item-active');
            });
          });
          dz.addEventListener('drop', function (e) {
            var files = e.dataTransfer && e.dataTransfer.files;
            if (files && files.length) {
              try {
                var dt = new DataTransfer();
                dt.items.add(files[0]);
                input.files = dt.files;
              } catch (err) {
                input.files = files;
              }
              rdudOnFileSelected(input);
            }
          });
        }

        function openReviewDiscussionUploadModal() {
          var overlay = document.getElementById('review-discussion-upload-overlay');
          if (overlay) {
            rdudReset();
            overlay.classList.add('urf-open');
          }
        }

        function closeReviewDiscussionUploadModal() {
          var overlay = document.getElementById('review-discussion-upload-overlay');
          if (overlay) {
            overlay.classList.remove('urf-open');
            setTimeout(rdudReset, 320);
          }
        }

        function resetReviewDiscussionForm() {
          var subject = document.getElementById('review-discussion-subject');
          if (subject) subject.value = '';
          var editor = document.getElementById('review-discussion-message-editor');
          var hidden = document.getElementById('review-discussion-message');
          if (editor) editor.innerHTML = '';
          if (hidden) hidden.value = '';
          var error = document.getElementById('review-discussion-error');
          if (error) error.style.display = 'none';
          rdAttachedFiles = [];
          renderReviewDiscussionAttachments();
          var searchBar = document.getElementById('rd-attach-search-bar');
          if (searchBar) searchBar.style.display = 'none';
  var searchInput = document.getElementById('rd-attach-search-input');
          if (searchInput) searchInput.value = '';
        }

        function rdFormatBytes(bytes) {
          if (!bytes && bytes !== 0) return '';
          if (bytes < 1024) return bytes + ' B';
          if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
          return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

        function renderReviewDiscussionAttachments() {
          var body = document.getElementById('rd-attach-body');
          var hidden = document.getElementById('rd-attached-files');
          if (!body) return;

          body.innerHTML = '';
          if (rdAttachedFiles.length === 0) {
            var empty = document.createElement('div');
            empty.className = 'prd-attach-empty';
            empty.textContent = 'No files are attached to this discussion.';
            body.appendChild(empty);
          } else {
            rdAttachedFiles.forEach(function (f) {
              var row = document.createElement('div');
              row.className = 'rd-attach-file-row';
              row.setAttribute('data-name', (f.name || '').toLowerCase());
              var chip = document.createElement('span');
              chip.className = 'prd-attach-file-chip';
              chip.textContent = f.name + (f.size ? ' (' + f.size + ')' : '');
              var remove = document.createElement('button');
              remove.type = 'button';
              remove.className = 'rd-remove-btn';
              remove.textContent = '\u00d7';
              remove.title = 'Remove file';
              remove.addEventListener('click', function () {
                rdAttachedFiles = rdAttachedFiles.filter(function (item) {
                  return item.id !== f.id;
                });
                renderReviewDiscussionAttachments();
              });
              row.appendChild(chip);
              row.appendChild(remove);
              body.appendChild(row);
            });
          }
          if (hidden) hidden.value = JSON.stringify(rdAttachedFiles);
        }

        function toggleReviewDiscussionSearch() {
          var bar = document.getElementById('rd-attach-search-bar');
          var input = document.getElementById('rd-attach-search-input');
          if (!bar) return;
          var hidden = bar.style.display === 'none' || bar.style.display === '';
          bar.style.display = hidden ? 'block' : 'none';
          if (hidden) {
            if (input) input.focus();
          } else {
            filterReviewDiscussionAttachments('');
          }
        }

        function filterReviewDiscussionAttachments(q) {
          var rows = document.querySelectorAll('#rd-attach-body .rd-attach-file-row');
          for (var i = 0; i < rows.length; i++) {
            var name = rows[i].getAttribute('data-name') || '';
            rows[i].style.display = name.indexOf(q) > -1 ? '' : 'none';
          }
        }

        function bindModalOverlayClose(overlayId, closeFn) {
          var overlay = document.getElementById(overlayId);
          if (overlay) {
            overlay.addEventListener('click', function (e) {
              if (e.target === overlay) closeFn();
            });
          }
        }

        function bindToolbarFieldSearch(btnId, barId, inputId, tableId) {
          var btn = document.getElementById(btnId);
          var bar = document.getElementById(barId);
          var input = document.getElementById(inputId);
          var table = document.getElementById(tableId);
          if (!btn || !bar || !input || !table) return;

          btn.addEventListener('click', function () {
            var hidden = bar.style.display === 'none' || bar.style.display === '';
            bar.style.display = hidden ? 'block' : 'none';
            if (hidden) input.focus();
          });

          input.addEventListener('input', function () {
            var q = input.value.trim().toLowerCase();
            var rows = table.querySelectorAll('tbody tr');
            for (var i = 0; i < rows.length; i++) {
              var name = (rows[i].getAttribute('data-name') || '').toLowerCase();
              var type = (rows[i].getAttribute('data-type') || '').toLowerCase();
              rows[i].style.display = (name.indexOf(q) > -1 || type.indexOf(q) > -1) ? '' : 'none';
            }
          });
        }

  function initReviewerFilesExtras() {
          rupBindDropzone();
          rdudBindDropzone();

          var uploadBtns = [
            document.getElementById('btn-upload-reviewer-file')
          ];
          uploadBtns.forEach(function (btn) {
            if (btn) btn.addEventListener('click', openUploadFileModal);
          });

    var addBtns = document.querySelectorAll('#btn-add-discussion');
          addBtns.forEach(function (btn) {
            btn.addEventListener('click', openReviewDiscussionModal);
          });

          var searchBtn = document.getElementById('rd-btn-search-file');
          if (searchBtn) searchBtn.addEventListener('click', toggleReviewDiscussionSearch);

          var searchInput = document.getElementById('rd-attach-search-input');
          if (searchInput) {
            searchInput.addEventListener('input', function () {
              filterReviewDiscussionAttachments(this.value.trim().toLowerCase());
            });
          }

          var discussionForm = document.getElementById('review-discussion-form');
          if (discussionForm) {
            discussionForm.addEventListener('submit', function (e) {
              var editor = document.getElementById('review-discussion-message-editor');
              var hidden = document.getElementById('review-discussion-message');
              var error = document.getElementById('review-discussion-error');
              if (editor && hidden) hidden.value = editor.innerHTML;
              var div = document.createElement('div');
              div.innerHTML = hidden ? hidden.value : '';
              var text = (div.textContent || '').replace(/\u00a0/g, ' ').trim();
              if (!text) {
                e.preventDefault();
                if (editor) editor.focus();
                if (error) error.style.display = 'block';
              }
            });
          }

          bindToolbarFieldSearch(
            'btn-search-reviewer-files',
            'search-reviewer-files-bar',
            'search-reviewer-files-input',
            'reviewer-files-table'
          );
          bindToolbarFieldSearch(
            'btn-search-review-files',
            'search-review-files-bar',
            'search-review-files-input',
            'review-files-table'
          );

  bindModalOverlayClose('upload-reviewer-file-overlay', closeUploadFileModal);
          bindModalOverlayClose('review-discussion-overlay', closeReviewDiscussionModal);
          bindModalOverlayClose('review-discussion-upload-overlay', closeReviewDiscussionUploadModal);

          document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            var overlay = document.getElementById('review-discussion-overlay');
            if (overlay && overlay.classList.contains('prd-open')) {
              closeReviewDiscussionModal();
            }
            var upOverlay = document.getElementById('review-discussion-upload-overlay');
            if (upOverlay && upOverlay.classList.contains('urf-open')) {
              closeReviewDiscussionUploadModal();
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReviewerFilesExtras);
        } else {
          initReviewerFilesExtras();
        }
</script>

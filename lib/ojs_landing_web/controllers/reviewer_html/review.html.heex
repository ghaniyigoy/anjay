<div class="review-page">
  <div class="review-breadcrumb">
    <a href="/dashboard/reviewAssignments">My Assignments</a>
    <span class="review-breadcrumb-sep">/</span> <span>Review #{@assignment.id}</span>
  </div>

  <div class="review-page-header">
    <div>
      <h1 class="review-page-title">
        {if @assignment.status in [:action_required, :in_progress],
          do: "Review: " <> truncate_title(@assignment.title),
          else: "Submission Review"}
      </h1>

      <p class="review-page-subtitle">
        Round {@assignment.round} · Due {Date.to_string(@assignment.due_date)}
      </p>
    </div>
    <span class={[
      "review-status-pill",
      if(@assignment.status == :published,
        do: "published",
        else: if(@assignment.status == :completed, do: "done")
      )
    ]}>{status_label(@assignment.status)}</span>
  </div>

  <ol class="rr-stepper">
    <%= for {num, label} <- [
      {1, "Request"},
      {2, "Guidelines"},
      {3, "Download & Review"},
      {4, "Completion"}
    ] do %>
      <li class={["rr-step", wizard_step_class(@assignment, num)]}>
        <span class="rr-step-num">{num}</span>
        <span class="rr-step-label">{label}</span>
      </li>
    <% end %>
  </ol>

  <div class="review-layout">
    <div class="review-main-col">
      <%= cond do %>
        <% @assignment.status == :action_required or (@assignment.status == :in_progress and @assignment.wizard_step == 1) -> %>
          <div class="rr-container">
            <section class="rr-section">
              <h2 class="rr-section-title">Request for Review</h2>

              <p class="rr-body">
                You have been selected as a potential reviewer of the following submission. Below
                is a summary of the submission. If you decide to review, your review comments will
                be sent back to the editor and made available to the author. The editor has asked
                you to review this submission.
              </p>

              <dl class="rr-meta-list">
                <div class="rr-meta-item">
                  <dt>Article Title</dt>
                  <dd>{@assignment.title}</dd>
                </div>

                <div class="rr-meta-item">
                  <dt>Abstract</dt>
                  <dd>{@assignment.abstract}</dd>
                </div>

                <div class="rr-meta-item">
                  <dt>Review Type</dt>
                  <dd>Round {to_string(@assignment.round)}</dd>
                </div>
              </dl>
            </section>

            <section class="rr-section">
              <div class="rr-files-header">
                <h2 class="rr-files-title">Review Files</h2>
                <div class="rr-files-search">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  Search
                </div>
              </div>

              <table class="rr-files-table">
                <thead>
                  <tr>
                    <th class="rr-files-col-name">
                      <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                        </path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                      </svg>
                      Files
                    </th>
                    <th class="rr-files-col-date">Date</th>
                    <th class="rr-files-col-type">Type</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for file <- @assignment.files do %>
                    <tr class="rr-file-row">
                      <td class="rr-files-col-name">
                        <a href="#" class="rr-file-link">{file.name}</a>
                      </td>
                      <td class="rr-files-col-date">{file.date}</td>
                      <td class="rr-files-col-type">
                        <span class={["rr-file-type", file_type_class(file.type)]}>
                          {file.type}
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>

              <a href="#" class="rr-view-all">View All Submission Details</a>
            </section>

            <section class="rr-section">
              <h2 class="rr-section-title">Review Schedule</h2>

              <div class="rr-schedule-grid">
                <div class="rr-schedule-item">
                  <span class="rr-schedule-label">Editor's Request</span>
                  <span class="rr-schedule-value">
                    {Date.to_string(@assignment.date_assigned)}
                  </span>
                </div>
                <div class="rr-schedule-item">
                  <span class="rr-schedule-label">Response Due Date</span>
                  <span class="rr-schedule-value">
                    {Date.to_string(@assignment.due_date)}
                  </span>
                </div>
                <div class="rr-schedule-item">
                  <span class="rr-schedule-label">Review Due Date</span>
                  <span class="rr-schedule-value">
                    {Date.to_string(@assignment.due_date)}
                  </span>
                </div>
              </div>

              <div class="rr-about-due">
                <a href="#" class="rr-due-link">About Due Dates</a>
              </div>

              <div class="rr-consent">
                <label class="rr-consent-label">
                  <input type="checkbox" class="rr-consent-checkbox" />
                  <span class="rr-consent-text">
                    Yes, I agree to have my data collected and stored according to the
                    privacy statement.
                  </span>
                </label>
              </div>

              <div class="rr-actions">
                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/decline"}
                  id="decline-review-request"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <button type="submit" class="btn-ojs-secondary" id="btn-decline-review">
                    Decline Review Request
                  </button>
                </form>
                <%= if @assignment.status == :in_progress do %>
                  <form
                    method="POST"
                    action={"/review/#{@assignment.id}/step"}
                    id="continue-review-request"
                  >
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    />
                    <button
                      type="submit"
                      class="btn-ojs-primary"
                      id="btn-continue-to-guidelines"
                    >
                      Continue to Step #2
                    </button>
                  </form>
                <% else %>
                  <form
                    method="POST"
                    action={"/review/#{@assignment.id}/accept"}
                    id="accept-review-request"
                  >
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    />
                    <button type="submit" class="btn-ojs-primary" id="btn-accept-review">
                      Accept Review, Continue to Step #2
                    </button>
                  </form>
                <% end %>
              </div>
            </section>
          </div>
        <% @assignment.status == :in_progress and @assignment.wizard_step in [2, 3] -> %>
          <%= if @assignment.wizard_step == 2 do %>
            <div class="rr-container">
              <section class="rr-section">
                <h2 class="rr-section-title">Review Guidelines</h2>

                <p class="rr-body">
                  Please read the review guidelines below before proceeding with your review.
                  Your comments should be constructive, specific, and respectful. Focus on the
                  substance of the manuscript and help the author improve their work.
                </p>

                <ul class="rr-guideline-list">
                  <li>Evaluate the originality and contribution of the research.</li>
                  <li>Assess the soundness of the methodology and analysis.</li>
                  <li>Provide clear, specific, and actionable feedback.</li>
                  <li>Keep your comments professional and constructive.</li>
                  <li>Do not share the manuscript or its contents.</li>
                </ul>

                <div class="rr-consent">
                  <label class="rr-consent-label">
                    <input type="checkbox" class="rr-consent-checkbox" id="guidelines-consent" />
                    <span class="rr-consent-text">
                      I have read and agree to follow the review guidelines.
                    </span>
                  </label>
                </div>
              </section>

              <div class="rr-actions">
                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/go-back"}
                  id="go-back-guidelines"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <button type="submit" class="btn-ojs-secondary" id="btn-go-back-guidelines">
                    Go Back
                  </button>
                </form>
                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/step"}
                  id="continue-guidelines"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <button type="submit" class="btn-ojs-primary" id="btn-continue-guidelines">
                    Continue to Step #3
                  </button>
                </form>
              </div>
            </div>
          <% else %>
            <div class="rp-container">
              <%!-- Review Files Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    Review Files
                  </h2>
                  <button type="button" class="rp-btn-search" id="btn-search-review-files">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    Search
                  </button>
                </div>
                <div class="rp-search-bar" id="search-review-files-bar" style="display:none">
                  <input
                    type="text"
                    id="search-review-files-input"
                    class="rp-search-input"
                    placeholder="Search files by name or type…"
                    data-target-table="review-files-table"
                  />
                </div>
                <div class="rp-panel-body">
                  <table class="rp-files-table" id="review-files-table">
                    <thead>
                      <tr>
                        <th>File</th>
                        <th>Date</th>
                        <th>Type</th>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for file <- @assignment.files do %>
                        <tr
                          data-name={String.downcase(file.name)}
                          data-type={String.downcase(file.type)}
                        >
                          <td><a href="#" class="rp-file-link">{file.name}</a></td>
                          <td class="rp-file-date">{file.date}</td>
                          <td>
                            <span class={["rp-file-badge", file_type_class(file.type)]}>
                              {file.type}
                            </span>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>

              <%!-- Review Form Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">Review</h2>
                </div>
                <div class="rp-panel-body">
                  <p class="rp-help-text">
                    Enter (or paste) your review of this submission into the form below.
                  </p>

                  <form method="POST" action={"/review/#{@assignment.id}/step"} id="review-form">
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    />

                    <%!-- For Author and Editor --%>
                    <div class="rp-field">
                      <label class="rp-label">For Author and Editor</label>
                      <div class="rp-richtext-wrapper">
                        <div id="rp-comments-author-toolbar" class="rp-toolbar">
                          <button
                            type="button"
                            data-cmd="bold"
                            class="rp-toolbar-btn"
                            title="Bold"
                          ><b>B</b></button>
                          <button
                            type="button"
                            data-cmd="italic"
                            class="rp-toolbar-btn"
                            title="Italic"
                          ><i>I</i></button>
                          <button
                            type="button"
                            data-cmd="underline"
                            class="rp-toolbar-btn"
                            title="Underline"
                          ><u>U</u></button>
                          <button
                            type="button"
                            data-cmd="insertUnorderedList"
                            class="rp-toolbar-btn"
                            title="Bullet List"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                            >
                              <line x1="8" y1="6" x2="21" y2="6"></line>
                              <line x1="8" y1="12" x2="21" y2="12"></line>
                              <line x1="8" y1="18" x2="21" y2="18"></line>
                              <line x1="3" y1="6" x2="3.01" y2="6"></line>
                              <line x1="3" y1="12" x2="3.01" y2="12"></line>
                              <line x1="3" y1="18" x2="3.01" y2="18"></line>
                            </svg>
                          </button>
                        </div>
                        <input
                          type="hidden"
                          name="comments_author"
                          id="rp-comments-author"
                          value=""
                        />
                        <div
                          id="rp-comments-author-editor"
                          class="rp-richtext"
                          data-target="rp-comments-author"
                          data-autosave={"review-draft-" <> Integer.to_string(@assignment.id) <> "-author"}
                          contenteditable="true"
                        ></div>
                      </div>
                    </div>

                    <%!-- For Editor --%>
                    <div class="rp-field">
                      <label class="rp-label">For Editor</label>
                      <div class="rp-richtext-wrapper">
                        <div id="rp-comments-editor-toolbar" class="rp-toolbar">
                          <button
                            type="button"
                            data-cmd="bold"
                            class="rp-toolbar-btn"
                            title="Bold"
                          ><b>B</b></button>
                          <button
                            type="button"
                            data-cmd="italic"
                            class="rp-toolbar-btn"
                            title="Italic"
                          ><i>I</i></button>
                          <button
                            type="button"
                            data-cmd="underline"
                            class="rp-toolbar-btn"
                            title="Underline"
                          ><u>U</u></button>
                          <button
                            type="button"
                            data-cmd="insertUnorderedList"
                            class="rp-toolbar-btn"
                            title="Bullet List"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                            >
                              <line x1="8" y1="6" x2="21" y2="6"></line>
                              <line x1="8" y1="12" x2="21" y2="12"></line>
                              <line x1="8" y1="18" x2="21" y2="18"></line>
                              <line x1="3" y1="6" x2="3.01" y2="6"></line>
                              <line x1="3" y1="12" x2="3.01" y2="12"></line>
                              <line x1="3" y1="18" x2="3.01" y2="18"></line>
                            </svg>
                          </button>
                        </div>
                        <input
                          type="hidden"
                          name="comments_editor"
                          id="rp-comments-editor"
                          value=""
                        />
                        <div
                          id="rp-comments-editor-editor"
                          class="rp-richtext"
                          data-target="rp-comments-editor"
                          data-autosave={"review-draft-" <> Integer.to_string(@assignment.id) <> "-editor"}
                          contenteditable="true"
                        ></div>
                      </div>
                    </div>
                  </form>
                </div>
              </div>

              <%!-- Upload Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">Upload</h2>
                </div>
                <div class="rp-panel-body">
                  <p class="rp-help-text">
                    Upload any files you wish to share with the author or editor. Files you
                    upload will appear in the Reviewer Files panel below.
                  </p>
                </div>
              </div>

              <%!-- Reviewer Files Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">Reviewer Files</h2>
                  <div class="rp-header-actions">
                    <button
                      type="button"
                      class="rp-btn-sm rp-btn-secondary"
                      id="btn-search-reviewer-files"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      </svg>
                      Search
                    </button>
                    <button
                      type="button"
                      class="rp-btn-sm rp-btn-primary"
                      id="btn-upload-reviewer-file"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                      Upload File
                    </button>
                  </div>
                </div>
                <div class="rp-search-bar" id="search-reviewer-files-bar" style="display:none">
                  <input
                    type="text"
                    id="search-reviewer-files-input"
                    class="rp-search-input"
                    placeholder="Search reviewer files…"
                    data-target-table="reviewer-files-table"
                  />
                </div>
                <div class="rp-panel-body rp-file-list" id="reviewer-files-list">
                  <%= if reviewer_files(@assignment.reviewer_files) == [] do %>
                    <div class="rp-empty-state" id="reviewer-files-empty">
                      <p>No reviewer files uploaded yet.</p>
                    </div>
                  <% else %>
                    <table class="rp-files-table rp-files-table-sm" id="reviewer-files-table">
                      <thead>
                        <tr>
                          <th>File</th>
                          <th>Date</th>
                          <th>Type</th>
                        </tr>
                      </thead>
                      <tbody>
                        <%= for file <- reviewer_files(@assignment.reviewer_files) do %>
                          <tr
                            data-name={String.downcase(file.name)}
                            data-type={String.downcase(file.type)}
                          >
                            <td>
                              <a href="#" class="rp-file-link">{file.name}</a>
                              <div class="rp-file-meta">{file.size}</div>
                            </td>
                            <td class="rp-file-date">{file.date}</td>
                            <td>
                              <span class={["rp-file-badge", file_type_class(file.type)]}>
                                {file.type}
                              </span>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  <% end %>
                </div>
              </div>

              <%!-- Review Discussions Section --%>
              <div class="rp-panel">
                <div class="rp-panel-header">
                  <h2 class="rp-panel-title">
                    Review Discussions
                    <span class="rp-badge-count" id="discussion-count">
                      {length(discussions(@assignment.discussions))}
                    </span>
                  </h2>
                  <button type="button" class="rp-btn-sm rp-btn-primary" id="btn-add-discussion">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add Discussion
                  </button>
                </div>
                <div class="rp-panel-body">
                  <%= if discussions(@assignment.discussions) == [] do %>
                    <div class="rp-empty-state">
                      <p>No discussions yet.</p>
                    </div>
                  <% else %>
                    <div class="rp-discussion-list">
                      <%= for d <- discussions(@assignment.discussions) do %>
                        <div class="rp-discussion">
                          <div class="rp-discussion-head">
                            <span class="rp-discussion-subject">{d.subject}</span>
                            <span class="rp-discussion-meta">
                              {d.author} &middot; {d.date}
                            </span>
                          </div>
                          <p class="rp-discussion-message">{d.message}</p>
                          <%= if d.replies in [nil, []] do %>
                            <span class="rp-discussion-no-replies">No replies yet</span>
                          <% else %>
                            <div class="rp-discussion-replies">
                              <%= for r <- d.replies do %>
                                <div class="rp-discussion-reply">
                                  <span class="rp-discussion-reply-author">{r.author}</span>
                                  <span class="rp-discussion-reply-date">{r.date}</span>
                                  <p class="rp-discussion-reply-message">{r.message}</p>
                                </div>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>

              <%!-- Upload File Modal --%>
              <div id="upload-reviewer-file-overlay" class="rp-modal-overlay" style="display:none">
                <div class="rp-modal">
                  <div class="rp-modal-header">
                    <h2 class="rp-modal-title">Upload Reviewer File</h2>
                    <button
                      type="button"
                      class="rp-modal-close"
                      onclick="closeUploadFileModal()"
                    >
                      &times;
                    </button>
                  </div>
                  <form
                    method="POST"
                    action={"/review/#{@assignment.id}/file"}
                    enctype="multipart/form-data"
                    id="upload-reviewer-file-form"
                  >
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    />
                    <div class="rp-modal-body">
                      <label class="rp-field-label" for="upload-file-input">File</label>
                      <input
                        type="file"
                        name="upload"
                        id="upload-file-input"
                        class="rp-file-input"
                        required
                      />
                      <div class="rp-field-row">
                        <div class="rp-field">
                          <label class="rp-field-label" for="upload-file-type">Type</label>
                          <select name="type" id="upload-file-type" class="rp-select">
                            <option value="PDF">PDF</option>
                            <option value="Word">Word</option>
                            <option value="Excel">Excel</option>
                            <option value="Image">Image</option>
                            <option value="Other">Other</option>
                          </select>
                        </div>
                      </div>
                    </div>
                    <div class="rp-modal-footer">
                      <button
                        type="button"
                        class="rp-btn rp-btn-secondary"
                        onclick="closeUploadFileModal()"
                      >
                        Cancel
                      </button>
                      <button type="submit" class="rp-btn rp-btn-primary" id="btn-upload-confirm">
                        Upload
                      </button>
                    </div>
                  </form>
                </div>
              </div>

              <%!-- Add Discussion Modal --%>
              <div id="add-discussion-overlay" class="rp-modal-overlay" style="display:none">
                <div class="rp-modal">
                  <div class="rp-modal-header">
                    <h2 class="rp-modal-title">Add Discussion</h2>
                    <button
                      type="button"
                      class="rp-modal-close"
                      onclick="closeDiscussionModal()"
                    >
                      &times;
                    </button>
                  </div>
                  <form
                    method="POST"
                    action={"/review/#{@assignment.id}/discussion"}
                    id="add-discussion-form"
                  >
                    <input
                      type="hidden"
                      name="_csrf_token"
                      value={Plug.CSRFProtection.get_csrf_token()}
                    />
                    <div class="rp-modal-body">
                      <label class="rp-field-label" for="discussion-subject">Subject</label>
                      <input
                        type="text"
                        name="subject"
                        id="discussion-subject"
                        class="rp-text-input"
                        placeholder="Brief subject line"
                        required
                      />
                      <label class="rp-field-label" for="discussion-message">Message</label>
                      <textarea
                        name="message"
                        id="discussion-message"
                        class="rp-textarea"
                        rows="5"
                        placeholder="Write your message…"
                        required
                      ></textarea>
                    </div>
                    <div class="rp-modal-footer">
                      <button
                        type="button"
                        class="rp-btn rp-btn-secondary"
                        onclick="closeDiscussionModal()"
                      >
                        Cancel
                      </button>
                      <button
                        type="submit"
                        class="rp-btn rp-btn-primary"
                        id="btn-discussion-submit"
                      >
                        Add Discussion
                      </button>
                    </div>
                  </form>
                </div>
              </div>

              <%!-- Actions for Step 3: Continue to Step 4 (Recommendation moved to Step 4 per OJS 4-step spec) --%>
              <div class="rp-panel">
                <div class="rp-panel-footer">
                  <div class="rp-actions">
                    <form
                      method="POST"
                      action={"/review/#{@assignment.id}/go-back"}
                      id="rp-go-back-form"
                    >
                      <input
                        type="hidden"
                        name="_csrf_token"
                        value={Plug.CSRFProtection.get_csrf_token()}
                      />
                      <button type="submit" class="rp-btn rp-btn-secondary" id="rp-btn-go-back">
                        Go back
                      </button>
                    </form>
                    <div class="rp-actions-right">
                      <button type="button" class="rp-btn rp-btn-secondary" id="rp-btn-save-later">
                        Save For Later
                      </button>
                      <button
                        type="submit"
                        form="review-form"
                        class="rp-btn rp-btn-primary"
                        id="rp-btn-submit-review"
                      >
                        Continue to Step 4
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% @assignment.status == :in_progress and @assignment.wizard_step == 4 -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              Completion
            </h2>

            <div class="review-submitted-summary">
              <p class="review-help">
                You have finished reviewing this submission. Select your final recommendation
                below and submit your review to the editor. You can still go back to review the
                manuscript or edit your comments at any time.
              </p>

              <%= if @assignment.comments_author not in [nil, ""] or @assignment.comments_editor not in [nil, ""] do %>
                <dl class="review-meta-list">
                  <%= if @assignment.comments_author not in [nil, ""] do %>
                    <div class="review-meta-item">
                      <dt>Comments to the Author</dt>
                      <dd>{@assignment.comments_author}</dd>
                    </div>
                  <% end %>

                  <%= if @assignment.comments_editor not in [nil, ""] do %>
                    <div class="review-meta-item">
                      <dt>Comments to the Editor</dt>
                      <dd>{@assignment.comments_editor}</dd>
                    </div>
                  <% end %>
                </dl>
              <% end %>

              <form method="POST" action={"/review/#{@assignment.id}"} id="completion-submit">
                <input
                  type="hidden"
                  name="_csrf_token"
                  value={Plug.CSRFProtection.get_csrf_token()}
                />
                <input
                  type="hidden"
                  name="comments_author"
                  value={@assignment.comments_author || ""}
                />
                <input
                  type="hidden"
                  name="comments_editor"
                  value={@assignment.comments_editor || ""}
                />

                <div class="review-field">
                  <span class="review-label">Recommendation <span class="review-req">*</span></span>
                  <p class="review-help">Select the overall recommendation for this submission.</p>

                  <div class="review-recommendation-options">
                    <label class="review-radio" id="rec-accept">
                      <input
                        type="radio"
                        name="recommendation"
                        value="Accept"
                        required
                        checked={@assignment.recommendation == "Accept"}
                      />
                      <span>Accept Submission</span>
                    </label>

                    <label class="review-radio" id="rec-revisions">
                      <input
                        type="radio"
                        name="recommendation"
                        value="Revisions Required"
                        required
                        checked={@assignment.recommendation == "Revisions Required"}
                      />
                      <span>Revisions Required</span>
                    </label>

                    <label class="review-radio" id="rec-resubmit">
                      <input
                        type="radio"
                        name="recommendation"
                        value="Resubmit for Review"
                        required
                        checked={@assignment.recommendation == "Resubmit for Review"}
                      />
                      <span>Resubmit for Review</span>
                    </label>

                    <label class="review-radio" id="rec-decline">
                      <input
                        type="radio"
                        name="recommendation"
                        value="Decline Submission"
                        required
                        checked={@assignment.recommendation == "Decline Submission"}
                      />
                      <span>Decline Submission</span>
                    </label>
                  </div>
                  <p class="review-help" style="margin-top: 8px; font-size: 12px;">
                    OJS alternatives: Resubmit Elsewhere / See Comments are also accepted if needed.
                  </p>
                </div>
              </form>

              <div class="review-form-actions">
                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/go-back"}
                  id="completion-go-back"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <button type="submit" class="btn-ojs-secondary" id="btn-completion-go-back">
                    Go Back to Review
                  </button>
                </form>
                <button
                  type="submit"
                  form="completion-submit"
                  class="btn-ojs-primary"
                  id="btn-completion-submit-review"
                >
                  Submit Review
                </button>
              </div>
            </div>

            <div class="review-discussions-panel">
              <div class="review-discussions-header">
                <h3>Review Discussions</h3>
                <button type="button" class="rp-btn-sm rp-btn-primary" id="btn-add-discussion">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  Add discussion
                </button>
              </div>

              <%= if discussions(@assignment.discussions) == [] do %>
                <div class="review-discussions-empty">
                  <p>No discussions have been started yet.</p>
                </div>
              <% else %>
                <div class="review-discussions-list">
                  <table class="rp-files-table review-discussions-table">
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>From</th>
                        <th>Last Reply</th>
                        <th>Replies</th>
                        <th>Closed</th>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for d <- discussions(@assignment.discussions) do %>
                        <tr>
                          <td><a href="#" class="rp-file-link">{d.subject}</a></td>
                          <td>{d.author}</td>
                          <td class="rp-file-date">{last_reply_date(d)}</td>
                          <td>{length(d.replies || [])}</td>
                          <td>
                            <span class="review-discussion-closed-state">
                              <input type="checkbox" class="review-discussion-closed" disabled />
                            </span>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
            </div>

            <%!-- Add Discussion Modal --%>
            <div id="add-discussion-overlay" class="rp-modal-overlay" style="display:none">
              <div class="rp-modal">
                <div class="rp-modal-header">
                  <h2 class="rp-modal-title">Add Discussion</h2>
                  <button
                    type="button"
                    class="rp-modal-close"
                    onclick="closeDiscussionModal()"
                  >
                    &times;
                  </button>
                </div>
                <form
                  method="POST"
                  action={"/review/#{@assignment.id}/discussion"}
                  id="add-discussion-form"
                >
                  <input
                    type="hidden"
                    name="_csrf_token"
                    value={Plug.CSRFProtection.get_csrf_token()}
                  />
                  <div class="rp-modal-body">
                    <label class="rp-field-label" for="discussion-subject">Subject</label>
                    <input
                      type="text"
                      name="subject"
                      id="discussion-subject"
                      class="rp-text-input"
                      placeholder="Brief subject line"
                      required
                    />
                    <label class="rp-field-label" for="discussion-message">Message</label>
                    <textarea
                      name="message"
                      id="discussion-message"
                      class="rp-textarea"
                      rows="5"
                      placeholder="Write your message…"
                      required
                    ></textarea>
                  </div>
                  <div class="rp-modal-footer">
                    <button
                      type="button"
                      class="rp-btn rp-btn-secondary"
                      onclick="closeDiscussionModal()"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      class="rp-btn rp-btn-primary"
                      id="btn-discussion-submit"
                    >
                      Add Discussion
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% @assignment.status == :declined -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
              Review Declined
            </h2>

            <div class="review-submitted-summary">
              <p class="review-help">
                You have declined this review assignment. The editor will find another reviewer
                for this submission.
              </p>

              <div class="review-form-actions">
                <a href="/dashboard/reviewAssignments" class="btn-ojs-primary">
                  Back to My Assignments
                </a>
              </div>
            </div>
          </div>
        <% @assignment.status == :published -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              Published
            </h2>

            <div class="review-submitted-summary">
              <p class="review-help">This submission has been published to the journal.</p>

              <dl class="review-meta-list">
                <div class="review-meta-item">
                  <dt>Issue</dt>

                  <dd>{@assignment.issue || "Current Issue"}</dd>
                </div>

                <div class="review-meta-item">
                  <dt>Published</dt>

                  <dd>
                    <%= if @assignment.published_at do %>
                      {@assignment.published_at |> DateTime.to_date() |> Date.to_string()}
                    <% else %>
                      —
                    <% end %>
                  </dd>
                </div>

                <div class="review-meta-item">
                  <dt>Galley Files</dt>

                  <dd>{length(@assignment.galley_files)}</dd>
                </div>
              </dl>

              <div class="review-form-actions">
                <a href="/dashboard/reviewAssignments" class="btn-ojs-primary">
                  Back to My Assignments
                </a>
              </div>
            </div>
          </div>
        <% @assignment.status == :completed -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              Review Submitted
            </h2>

            <div class="review-submitted-summary">
              <p class="review-help">
                Your review for this submission has been recorded and the workflow has moved to the
                next stage. Thank you for your contribution.
              </p>

              <dl class="review-meta-list">
                <div class="review-meta-item">
                  <dt>Recommendation</dt>

                  <dd>{@assignment.recommendation || "None"}</dd>
                </div>

                <%= if @assignment.comments_author do %>
                  <div class="review-meta-item">
                    <dt>Comments to the Author</dt>

                    <dd>{@assignment.comments_author}</dd>
                  </div>
                <% end %>

                <%= if @assignment.comments_editor do %>
                  <div class="review-meta-item">
                    <dt>Comments to the Editor</dt>

                    <dd>{@assignment.comments_editor}</dd>
                  </div>
                <% end %>
              </dl>

              <div class="review-form-actions">
                <a href="/dashboard/reviewAssignments" class="btn-ojs-secondary">
                  Back to My Assignments
                </a>
              </div>
            </div>
          </div>
        <% true -> %>
          <div class="review-panel">
            <h2 class="review-panel-title">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>

                <polyline points="7 10 12 15 17 10"></polyline>

                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Review Submission
            </h2>

            <form method="POST" action={"/review/#{@assignment.id}"}>
              <input
                type="hidden"
                name="_csrf_token"
                value={Plug.CSRFProtection.get_csrf_token()}
              />
              <div class="review-field">
                <label class="review-label" for="recommendation">
                  Recommendation <span class="review-req">*</span>
                </label>

                <p class="review-help">Select the overall recommendation for this submission.</p>

                <select id="recommendation" name="recommendation" class="review-select" required>
                  <option value="" disabled selected>Select a recommendation…</option>

                  <option value="Accept">Accept</option>

                  <option value="Minor Revisions">Minor Revisions</option>

                  <option value="Major Revisions">Major Revisions</option>

                  <option value="Resubmit Elsewhere">Resubmit Elsewhere</option>

                  <option value="Decline">Decline</option>
                </select>
              </div>

              <div class="review-field">
                <span class="review-label">Quality Criteria</span>
                <p class="review-help">Assess each criterion below.</p>

                <div class="review-criteria">
                  <%= for {criterion, index} <- Enum.with_index(@criteria) do %>
                    <div class="review-criterion">
                      <div class="review-criterion-text">
                        <span class="review-criterion-label">
                          {index + 1}. {criterion.label}
                        </span>
                        <span class="review-criterion-question">{criterion.question}</span>
                      </div>

                      <div class="review-criterion-options">
                        <label class="review-radio">
                          <input
                            type="radio"
                            name={"criterion_#{index}"}
                            value="Yes"
                            checked={index == 0}
                          /> <span>Yes</span>
                        </label>

                        <label class="review-radio">
                          <input type="radio" name={"criterion_#{index}"} value="No" />
                          <span>No</span>
                        </label>

                        <label class="review-radio">
                          <input type="radio" name={"criterion_#{index}"} value="Maybe" />
                          <span>Maybe</span>
                        </label>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="review-field">
                <label class="review-label" for="comments_author">Comments to the Author</label>
                <p class="review-help">
                  This review will be shared with the author. Be specific and constructive.
                </p>
                <textarea
                  id="comments_author"
                  name="comments_author"
                  rows="7"
                  class="review-textarea"
                  placeholder="Summarize the main strengths and weaknesses of the manuscript…"
                ></textarea>
              </div>

              <div class="review-field">
                <label class="review-label" for="comments_editor">Comments to the Editor</label>
                <p class="review-help">
                  Private comments that will only be visible to the editor.
                </p>
                <textarea
                  id="comments_editor"
                  name="comments_editor"
                  rows="4"
                  class="review-textarea"
                  placeholder="Confidential feedback for the editor…"
                ></textarea>
              </div>

              <div class="review-form-actions">
                <button type="submit" class="btn-ojs-primary">Submit Review</button>
                <a href="/dashboard/reviewAssignments" class="btn-ojs-secondary">Cancel</a>
              </div>
            </form>
          </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  function openUploadFileModal() {
    var overlay = document.getElementById('upload-reviewer-file-overlay');
    if (overlay) {
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeUploadFileModal() {
    var overlay = document.getElementById('upload-reviewer-file-overlay');
    if (overlay) {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  function openDiscussionModal() {
    var overlay = document.getElementById('add-discussion-overlay');
    if (overlay) {
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeDiscussionModal() {
    var overlay = document.getElementById('add-discussion-overlay');
    if (overlay) {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  function bindModalOverlayClose(overlayId, closeFn) {
    var overlay = document.getElementById(overlayId);
    if (overlay) {
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeFn();
      });
    }
  }

  function bindToolbarFieldSearch(btnId, barId, inputId, tableId) {
    var btn = document.getElementById(btnId);
    var bar = document.getElementById(barId);
    var input = document.getElementById(inputId);
    var table = document.getElementById(tableId);
    if (!btn || !bar || !input || !table) return;

    btn.addEventListener('click', function () {
      var hidden = bar.style.display === 'none' || bar.style.display === '';
      bar.style.display = hidden ? 'block' : 'none';
      if (hidden) input.focus();
    });

    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var rows = table.querySelectorAll('tbody tr');
      for (var i = 0; i < rows.length; i++) {
        var name = (rows[i].getAttribute('data-name') || '').toLowerCase();
        var type = (rows[i].getAttribute('data-type') || '').toLowerCase();
        rows[i].style.display = (name.indexOf(q) > -1 || type.indexOf(q) > -1) ? '' : 'none';
      }
    });
  }

  function initReviewerFilesExtras() {
    var uploadBtns = [
      document.getElementById('btn-upload-reviewer-file')
    ];
    uploadBtns.forEach(function (btn) {
      if (btn) btn.addEventListener('click', openUploadFileModal);
    });

    var addBtn = document.getElementById('btn-add-discussion');
    if (addBtn) addBtn.addEventListener('click', openDiscussionModal);

    bindToolbarFieldSearch(
      'btn-search-reviewer-files',
      'search-reviewer-files-bar',
      'search-reviewer-files-input',
      'reviewer-files-table'
    );
    bindToolbarFieldSearch(
      'btn-search-review-files',
      'search-review-files-bar',
      'search-review-files-input',
      'review-files-table'
    );

    bindModalOverlayClose('upload-reviewer-file-overlay', closeUploadFileModal);
    bindModalOverlayClose('add-discussion-overlay', closeDiscussionModal);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviewerFilesExtras);
  } else {
    initReviewerFilesExtras();
  }
</script>

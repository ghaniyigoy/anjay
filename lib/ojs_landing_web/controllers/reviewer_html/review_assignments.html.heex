<div class="reviewer-dashboard-container">
  <!-- Sidebar -->
  <aside class="reviewer-sidebar">
    <div class="sidebar-section">
      <div class="sidebar-header" onclick="toggleSidebarSection(this)">
        <svg
          class="sidebar-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          
          <polyline points="14 2 14 8 20 8"></polyline>
          
          <line x1="16" y1="13" x2="8" y2="13"></line>
          
          <line x1="16" y1="17" x2="8" y2="17"></line>
          
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
         <span class="sidebar-title">My Assignments as Reviewer</span>
        <svg
          class="sidebar-arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
      
      <ul class="sidebar-menu">
        <li class={if @current_view == "reviewer-action-required", do: "active"}>
          <a href="/dashboard/reviewAssignments?currentViewId=reviewer-action-required">
            <span class={[
              "badge",
              badge_class(
                "reviewer-action-required",
                Enum.count(@all_assignments, fn a -> a.status == :action_required end)
              )
            ]}>{Enum.count(@all_assignments, fn a -> a.status == :action_required end)}</span>
            Action Required by me
          </a>
        </li>
        
        <li class={if @current_view == "reviewer-assignments-all", do: "active"}>
          <a href="/dashboard/reviewAssignments?currentViewId=reviewer-assignments-all">
            <span class={[
              "badge",
              badge_class("reviewer-assignments-all", length(@all_assignments))
            ]}>{length(@all_assignments)}</span>
            All assignments
          </a>
        </li>
        
        <li class={if @current_view == "reviewer-assignments-completed", do: "active"}>
          <a href="/dashboard/reviewAssignments?currentViewId=reviewer-assignments-completed">
            <span class={[
              "badge",
              badge_class(
                "reviewer-assignments-completed",
                Enum.count(@all_assignments, fn a -> a.status == :completed end)
              )
            ]}>{Enum.count(@all_assignments, fn a -> a.status == :completed end)}</span>
            Completed
          </a>
        </li>
        
        <li class={if @current_view == "reviewer-assignments-declined", do: "active"}>
          <a href="/dashboard/reviewAssignments?currentViewId=reviewer-assignments-declined">
            <span class={[
              "badge",
              badge_class(
                "reviewer-assignments-declined",
                Enum.count(@all_assignments, fn a -> a.status == :declined end)
              )
            ]}>{Enum.count(@all_assignments, fn a -> a.status == :declined end)}</span>
            Declined
          </a>
        </li>
        
        <li class={if @current_view == "reviewer-assignments-published", do: "active"}>
          <a href="/dashboard/reviewAssignments?currentViewId=reviewer-assignments-published">
            <span class={[
              "badge",
              badge_class(
                "reviewer-assignments-published",
                Enum.count(@all_assignments, fn a -> a.status == :published end)
              )
            ]}>{Enum.count(@all_assignments, fn a -> a.status == :published end)}</span>
            Published
          </a>
        </li>
        
        <li class={if @current_view == "reviewer-assignments-archived", do: "active"}>
          <a href="/dashboard/reviewAssignments?currentViewId=reviewer-assignments-archived">
            <span class={[
              "badge",
              badge_class(
                "reviewer-assignments-archived",
                Enum.count(@all_assignments, fn a -> a.status == :archived end)
              )
            ]}>{Enum.count(@all_assignments, fn a -> a.status == :archived end)}</span>
            Archived
          </a>
        </li>
      </ul>
    </div>
  </aside>
  <!-- Main Content -->
  <div class="reviewer-main-content">
    <h1 class="page-heading">
      {case @current_view do
        "reviewer-action-required" -> "Action Required by me"
        "reviewer-assignments-all" -> "All assignments"
        "reviewer-assignments-completed" -> "Completed"
        "reviewer-assignments-declined" -> "Declined"
        "reviewer-assignments-published" -> "Published"
        "reviewer-assignments-archived" -> "Archived"
        _ -> "My Assignments"
      end} ({length(@assignments)})
    </h1>
    
    <div class="content-toolbar">
      <div class="toolbar-left">
        <button class="btn-filter">Filters</button>
      </div>
      
      <div class="toolbar-right">
        <div class="search-box">
          <svg
            class="search-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle>
            
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          
          <input
            type="text"
            placeholder="Search submissions, ID, authors, ..."
            class="search-input"
          />
        </div>
      </div>
    </div>
    
    <div class="submissions-table-wrapper">
      <table class="submissions-table">
        <thead>
          <tr>
            <th class="col-id">
              ID
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 15l5 5 5-5"></path>
                
                <path d="M7 9l5-5 5 5"></path>
              </svg>
            </th>
            
            <th class="col-submissions">SUBMISSIONS</th>
            
            <th class="col-editorial">EDITORIAL ACTIVITY</th>
            
            <th class="col-actions">ACTIONS</th>
          </tr>
        </thead>
        
        <tbody>
          <%= if length(@assignments) == 0 do %>
            <tr>
              <td colspan="4" class="no-items">No Items</td>
            </tr>
          <% else %>
            <%= for assignment <- @assignments do %>
              <tr>
                <td class="col-id">{assignment.id}</td>
                
                <td class="col-submissions">
                  <div class="submission-info">
                    <span class="submission-author">{assignment.author}</span>
                    <span class="submission-title">— {assignment.title}</span>
                  </div>
                </td>
                
                <td class="col-editorial"></td>
                
                <td class="col-actions">
                  <a href={"/review/#{assignment.id}"} class="btn-view">Review</a>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
      
      <div class="table-footer">
        Showing <strong>0 to {max(0, length(@assignments))}</strong>
        of <strong>{length(@assignments)}</strong>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleSidebarSection(header) {
    var menu = header.nextElementSibling;
    var arrow = header.querySelector('.sidebar-arrow');
    if (menu.style.display === 'none') {
      menu.style.display = 'block';
      arrow.style.transform = 'rotate(0deg)';
    } else {
      menu.style.display = 'none';
      arrow.style.transform = 'rotate(-90deg)';
    }
  }
</script>

<div id="issues" class="manage-issues-page">
  <header class="manage-issues-header">
    <div class="manage-issues-breadcrumb">
      <a href="/dashboard">Dashboard</a>
      <span class="manage-issues-breadcrumb-sep">/</span>
      <span>Issues</span>
    </div>

    <div class="manage-issues-heading">
      <h1 class="manage-issues-title">Issues</h1>

      <p class="manage-issues-subtitle">
        Create, edit and publish the issues of {@journal.title}.
      </p>
    </div>
  </header>

  <% groups = issue_groups(@issues) %>

  <nav class="ojs-submission-tabs manage-issues-tabs" aria-label="Issue views">
    <a href="#future" data-tab="future" class="active">
      Future Issues <span class="ojs-tab-count">{length(groups.future)}</span>
    </a>

    <a href="#back-issues" data-tab="back-issues">
      Back Issues <span class="ojs-tab-count">{length(groups.back)}</span>
    </a>
  </nav>

  <%!-- Future Issues --%>
  <div id="future" class="ojs-submission-tab-panel manage-issues-panel active">
    <div class="manage-issues-toolbar">
      <span class="manage-issues-toolbar-hint">
        Unpublished issues that have not yet been made available to readers.
      </span>

      <button type="button" class="btn-ojs-primary manage-issues-create">Create Issue</button>
    </div>

    <%= if length(groups.future) > 0 do %>
      <div class="manage-issues-list">
        <%= for issue <- groups.future do %>
          <div id={"issue-row-#{issue.id}"} class="manage-issue-item">
            <button
              type="button"
              class="manage-issue-toggle"
              aria-label="Toggle actions"
              onclick="toggleIssueActions(this)"
            >
              <svg
                class="manage-issue-caret"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <div class="manage-issue-main">
              <span class="settings-issue-label">{issue_volume_label(issue)}</span>
              <span class="manage-issue-title">{issue.title}</span>
              <span class="manage-issue-count">{issue_article_count(issue)} article(s)</span>
            </div>

            <div id={"issue-actions-#{issue.id}"} class="manage-issue-actions">
              <a href={~p"/#{@journal_path}/issue/#{issue.id}"} class="settings-row-action">
                View
              </a>
              <a href="#" class="settings-row-action">Edit</a>
              <a href="#" class="settings-row-action">Unpublish</a>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="ojs-empty-state">No future issues have been created yet.</div>
    <% end %>
  </div>

  <%!-- Back Issues --%>
  <div id="back-issues" class="ojs-submission-tab-panel manage-issues-panel">
    <div class="manage-issues-toolbar">
      <span class="manage-issues-toolbar-hint">All published issues of this journal.</span>
    </div>

    <%= if length(groups.back) > 0 do %>
      <div class="manage-issues-list">
        <%= for issue <- groups.back do %>
          <div id={"issue-row-#{issue.id}"} class="manage-issue-item">
            <button
              type="button"
              class="manage-issue-toggle"
              aria-label="Toggle actions"
              phx-click={JS.toggle(to: "#issue-actions-#{issue.id}")}
            >
              <svg
                class="manage-issue-caret"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <div class="manage-issue-main">
              <span class="settings-issue-label">{issue_volume_label(issue)}</span>
              <span class="manage-issue-title">{issue.title}</span>
              <span class="manage-issue-count">{issue_article_count(issue)} article(s)</span>
            </div>

            <div id={"issue-actions-#{issue.id}"} class="manage-issue-actions">
              <a href={~p"/#{@journal_path}/issue/#{issue.id}"} class="settings-row-action">
                View
              </a>
              <a href="#" class="settings-row-action">Edit</a>
              <a href="#" class="settings-row-action">Unpublish</a>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="ojs-empty-state">No back issues have been published yet.</div>
    <% end %>
  </div>
</div>

<script>
  (function () {
    function toggleIssueActions(button) {
      var item = button.closest('.manage-issue-item');
      var actions = item.querySelector('.manage-issue-actions');
      var caret = button.querySelector('.manage-issue-caret');
      var open = item.classList.contains('is-open');
      item.classList.toggle('is-open', !open);
      actions.style.display = open ? 'none' : 'flex';
      caret.style.transform = open ? '' : 'rotate(0deg)';
    }

    var validTabs = ['future', 'back-issues'];
    var tabs = document.querySelector('.manage-issues-tabs');
    if (!tabs) return;
    var links = tabs.querySelectorAll('a[data-tab]');
    var panels = document.querySelectorAll('.manage-issues-panel');

    function activate(name) {
      var tab = validTabs.indexOf(name) >= 0 ? name : 'future';
      for (var i = 0; i < links.length; i++) {
        links[i].classList.toggle('active', links[i].getAttribute('data-tab') === tab);
      }
      for (var j = 0; j < panels.length; j++) {
        panels[j].classList.toggle('active', panels[j].getAttribute('id') === tab);
      }
    }

    function currentTab() {
      return window.location.hash.replace('#', '');
    }

    window.addEventListener('hashchange', function () {
      activate(currentTab());
    });

    activate(currentTab());
  })();
</script>
